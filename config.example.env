# wake configuration. Copy to ~/.config/wake/config.env (or point WAKE_CONFIG at it).
# Environment variables with the same name override these values.

# Webhook endpoint prefix. wake POSTs to $WAKE_API_BASE/<bot-id>/webhook. Required for sending.
WAKE_API_BASE=https://bots.example.com/api/v1/bots

# wake-mcp: the stdio server local clients run. With a token it bridges to POST {WAKE_MCP_API}/mcp
# and exposes the server's ten thread tools; without one it is the legacy two-tool CLI helper.
# Plain http is for loopback only; any other host needs https, or the token crosses in clear.
# Keep this file at mode 600: it holds the token.
WAKE_MCP_API=http://127.0.0.1:3001
#WAKE_MCP_TOKEN=

# Shared state on the host: threads/ and inbox/ live here.
# This is the checkout default. A deployment may patch the host copy to a site directory
# of its own (for example /var/lib/wake-site, root:wake, setgid), so check the host
# before assuming this path.
WAKE_STATE_DIR=/var/lib/wake

# Where <bot-id>.key files are kept (mode 600). Default: the config directory.
#WAKE_KEY_DIR=~/.config/wake

# Bot registry (tab-separated: alias, id, name, open|private, role). Default: $WAKE_CONFIG_DIR/bots.tsv.
# On the host itself a shared copy is common: WAKE_REGISTRY=/var/lib/wake/bots.tsv
#WAKE_REGISTRY=~/.config/wake/bots.tsv

# Guest mode: an executable that runs its single argument as a shell command on the host
# (stdin passed through), e.g. an ssh wrapper. Leave empty when wake runs on the host itself.
#WAKE_HOSTOPS=/opt/wake/host-exec

# Command that mints webhook keys on the host: `has-key ID` -> yes|no, `ID [--rotate]` -> key, `enable-bot ID`.
#WAKE_KEY_HELPER=wake-webhook-key

# Group allowed to read key files; wake retries through `sg $WAKE_GROUP` on permission errors.
#WAKE_GROUP=wake

# Group given to the host copy of the registry by `wake --sync`. Empty (default) leaves the group unchanged.
#WAKE_REGISTRY_GROUP=wake

# Directory of the per-user rate log wake-rate-<uid>.json.
#WAKE_RATE_DIR=/tmp

# Default bot for wake-hook, wake-run and the legacy `wake <source> <event> [detail]` form.
#WAKE_BOT=coordinator

# --- API doorbell (apps/api only) ---------------------------------------
# Ring a bot's Rakazo webhook after its message is committed. JSON object, agent name -> bot
# id + that bot's webhook secret. Keep this file mode 600: the secret never leaves the server.
# Empty leaves the doorbell off and sends still work. See docs/doorbell.md.
#WAKE_DOORBELL_BOTS='{"engineer":{"botId":"cmw...","secret":"..."}}'
#WAKE_DOORBELL_URL=http://127.0.0.1:3417/api/v1/bots
# 100..9000 ms: two attempts plus backoff stay under the CLI's 20 s send timeout.
#WAKE_DOORBELL_TIMEOUT_MS=1500
# Wakes per sender to one recipient per hour: the CLI's HOURLY_CAP number, but
# scoped per sender on purpose (the CLI's bucket is fleet-wide per bot).
# In-process; 0 disables.
#WAKE_DOORBELL_MAX_PER_HOUR=30

# --- MCP endpoint (apps/api only) ---------------------------------------
# Off unless this is true. One public credential: the `mcp` agent's token,
# provisioned with POST /mcp/identity (needs REGISTRATION_SECRET).
#WAKE_MCP_ENABLED=true
# Requests per minute per token, in-process; 0 disables. See docs/mcp.md.
#WAKE_MCP_RATE_LIMIT_PER_MINUTE=60

# --- operator helpers (bin/ops) -----------------------------------------
# wake-deploy: where the scripts go and which targets get them.
#WAKE_PREFIX=~/.local/bin
#WAKE_DEPLOY_TARGETS=local
# 1 = a remote install runs through `sudo -n`, for a prefix such as /usr/local/bin.
#WAKE_SSH_SUDO=0
# The two agent extension files to copy alongside (wake.ts, wake-inbox.ts).
#WAKE_EXTENSION_SRC=~/.omp/agent/extensions
#WAKE_EXTENSION_DIRS=~/.omp/agent/extensions:~/.pi/agent/extensions

# wake-gate-check: the optional steps, so a gate review is one command.
#WAKE_GATE_SELFTEST=
#WAKE_GATE_HARNESS=
#WAKE_GATE_E2E=
# A gate artifact to check against; wake-shape-check and tests/test_gate_shapes.py read it too.
#WAKE_GATE=

# wake-host-deploy: the host and the service it installs. One transport is required:
# WAKE_HOSTOPS (a runner for one shell command) or WAKE_HOST_SSH (an ssh destination).
#WAKE_HOSTOPS=/opt/wake/host-exec
#WAKE_HOST_SSH=deploy@host
#WAKE_SUDO=sudo -n
#WAKE_SERVICE=wake-api
#WAKE_SERVICE_USER=wake
#WAKE_SERVICE_GROUP=wake
#WAKE_INSTALL_DIR=/opt/wake
#WAKE_ENV_FILE=/etc/wake/api.env
#WAKE_UNIT_DIR=/etc/systemd/system
#WAKE_BUILDER=bun
#WAKE_NODE=/usr/bin/node
#WAKE_DB_NAME=wake
#WAKE_DB_ROLE=wake
#WAKE_DB_HOST=127.0.0.1
#WAKE_DB_PORT=5432
#WAKE_PORT=3001
#WAKE_BIND=127.0.0.1
# The `env` step reads WAKE_DB_PASSWORD and WAKE_REGISTRATION_SECRET from the environment
# and writes them through stdin. They are never printed and never go in this file.
