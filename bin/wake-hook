#!/usr/bin/env python3
# desc: adapter that turns Claude Code hook JSON (stdin) or Codex notify JSON (last arg) into a wake. Usage: wake-hook claude-code Stop|StopFailure | wake-hook codex '<json>'. Off unless WAKE_HOOK=errors|all
import json, os, subprocess, sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wake_config  # noqa: E402

mode = os.environ.get("WAKE_HOOK", "")
if mode not in ("1", "errors", "all"):
    sys.exit(0)
harness = sys.argv[1] if len(sys.argv) > 1 else "harness"
try:
    raw = sys.argv[-1] if harness == "codex" and len(sys.argv) > 2 else sys.stdin.read()
    d = json.loads(raw or "{}")
except Exception:
    d = {}
cwd = d.get("cwd") or os.getcwd()
repo = os.path.basename(cwd.rstrip("/")) or cwd
msg = (d.get("last_assistant_message") or d.get("last-assistant-message") or "").strip().splitlines()
first = (msg[0] if msg else "")[:160]
event = sys.argv[2] if harness != "codex" and len(sys.argv) > 2 else (d.get("hook_event_name") or d.get("type") or "agent_end")
failed = event == "StopFailure"
if not failed and mode != "all":
    sys.exit(0)
if harness == "claude-code" and event == "Stop" and d.get("stop_hook_active"):
    sys.exit(0)  # a stop hook already continued this turn; do not double-report
detail = (f"{harness} run failed in {repo}: {d.get('error', 'error')} {first}" if failed else f"{harness} run finished in {repo}: {first}").strip()
subprocess.Popen(["wake", wake_config.load()["WAKE_BOT"], detail, "--source", f"harness:{harness}", "--event", event,
                  "--level", "error" if failed else "ok"],
                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
