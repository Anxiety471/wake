#!/usr/bin/env python3
# desc: wake any bot over its webhook; ask it a question and read the answer. `wake` = picker; `wake ops "check disk"`; `wake --info engineer`; `wake --ask engineer "why does CI fail" --wait 180`; `wake --reply <id> "..."`; `wake --inbox`; `wake --list`; `wake --who dns`. See wake --help
import argparse
import datetime
import hashlib
import json
import os
import random
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wake_config  # noqa: E402

CFG = wake_config.load()
BASE = CFG["WAKE_API_BASE"].rstrip("/")
REGISTRY = CFG["WAKE_REGISTRY"]  # bots.tsv: alias, id, name, kind, role
KEYS = CFG["WAKE_KEY_DIR"]  # <bot-id>.key files, mode 600
HOSTOPS = CFG["WAKE_HOSTOPS"]  # set = this shell is a guest that reaches the host through HOSTOPS
STATE = CFG["WAKE_STATE_DIR"]
THREADS = STATE + "/threads"  # on the host: shared by every bot and session that talks through it
KEY_HELPER = CFG["WAKE_KEY_HELPER"]
GROUP = CFG["WAKE_GROUP"]
DEFAULT_BOT = CFG["WAKE_BOT"]
# A wake is a message between bots; the human should see that one arrived, not the answer to it.
# The flag rides in the payload (silent) and as a tail on detail, so a receiver needs no per-bot
# routine edit to stay quiet. The tone follows the sender unless WAKE_SILENT forces one tone for
# every send; --chatty is the one-send override.
_SILENT_CFG = str(CFG["WAKE_SILENT"]).strip().lower()
SILENT = None if _SILENT_CFG in ("", "auto", "source") else _SILENT_CFG not in ("0", "false", "no", "off")
SILENT_TAIL = (
    "[silent wake: post no chat output to the human; answer in the thread store (wake --reply) "
    "or message_bot, then end the turn with no chat message]"
)
q = shlex.quote


def default_silent(source):
    """The tone a wake carries when the config forces none.

    A bot or agent session is answered in the thread store and ends its turn: its chat is already
    a message to someone else. A person at a shell reads the answer in the chat in front of them,
    so their wake is chatty.
    """
    return not (source or "").startswith("human:")


def tone_for(source):
    """The tone one send carries: the forced config tone if there is one, else the sender's own."""
    return SILENT if SILENT is not None else default_silent(source)


def operator_tone():
    """The tone of a command that fans out to every bot: quiet unless the machine forces one.

    --update --ping and --all are operator actions, not answers to a shell, so a person who
    runs them still gets the quiet send they got before the tone followed the sender. The docs call
    the ping quiet, and a broadcast that starts a run on every bot posts one chat line per bot.
    WAKE_SILENT=1/0 and --chatty still win: that caller said which tone it wanted.
    """
    return True if SILENT is None else SILENT


AGENT_NAMES = {"omp": "Oh My Pi"}  # display names for agent harnesses; others show their label as is
# The API accepts a 64 KiB body (413 above it). `message` repeats most of `detail`, so a long wake
# would double past that and be lost; drop the duplicate once the encoded payload passes this.
PAYLOAD_MAX = 60000


def load():
    if not os.path.exists(REGISTRY):
        sys.exit(f"no bot registry at {REGISTRY}; copy bots.example.tsv there or set WAKE_REGISTRY")
    rows = []
    for line in open(REGISTRY):
        a = line.rstrip("\n").split("\t")
        if len(a) in (4, 5):
            rows.append(dict(alias=a[0], id=a[1], name=a[2], kind=a[3], role=(a[4] if len(a) > 4 else "")))
    return rows


def by_role(words, bots):
    """Bots whose role text matches any of the words, best match first, private ones last."""
    w = [x.lower() for x in words if x]
    scored = []
    for b in bots:
        hay = (b["role"] + " " + b["name"]).lower()
        n = sum(1 for x in w if x in hay)
        if n:
            scored.append((b["kind"] == "private", -n, b["alias"], b))
    return [b for _, _, _, b in sorted(scored)]


def resolve(q, bots):
    q = q.lower()
    for b in bots:
        if q in (b["alias"], b["id"]):
            return b
    hits = [b for b in bots if q in b["name"].lower() or q in b["alias"]]
    return hits[0] if len(hits) == 1 else None


def in_container():
    """A guest (bot computer) reaches the host through WAKE_HOSTOPS; without it, this shell is on the host."""
    return bool(HOSTOPS)


def own_bot(bots):
    """Which bot this shell is running inside: a bot computer's cwd is .../bots/<id>, or the
    config dir names it in a `self` file (a harness that runs from a neutral cwd, e.g. /tmp)."""
    cwd = os.path.realpath(os.getcwd()) + "/"
    for b in bots:
        if f"/bots/{b['id']}/" in cwd:
            return b
    try:
        with open(os.path.join(CFG["WAKE_CONFIG_DIR"], "self")) as f:
            me = f.read().strip()
    except OSError:
        return None
    for b in bots:
        if me and me in (b["alias"], b["id"]):
            return b
    return None


def default_source():
    # kind:name label. Hooks pass --source harness:<name>; this is only the fallback. Labels, not proof.
    if os.environ.get("WAKE_SOURCE"):
        return os.environ["WAKE_SOURCE"]
    b = own_bot(load()) if os.path.exists(REGISTRY) else None
    if b:
        return "bot:" + b["alias"]
    if in_container():
        return "bot:container"
    return "human:" + os.environ.get("USER", "unknown")


def context():
    return f"host={os.uname().nodename} user={os.environ.get('USER', '?')} cwd={os.getcwd()}"


def host(cmd):
    """Run a shell command on the host: through HOSTOPS from a guest, directly on the host itself."""
    argv = [HOSTOPS, cmd] if HOSTOPS else ["bash", "-c", cmd]
    r = subprocess.run(argv, capture_output=True, text=True)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


SYNC_REFUSAL = "registry sync is an operator action; run it on the host"


def sync_registry(show_rows=True):
    """Hand the bot list to the host copy -- on the host, not from a guest.

    A guest shell ingests untrusted content (webhook payloads, mail, pages). Giving it
    `sudo tee` on bots.tsv would hand the routing table every bot trusts to whatever that
    content says, so a guest prints the rows it would have written and exits non-zero
    without touching the host. Returns the exit code."""
    rows = open(REGISTRY).read()
    if HOSTOPS and os.path.exists(HOSTOPS) and in_container():
        if show_rows:
            sys.stdout.write(rows if rows.endswith("\n") else rows + "\n")
        print("would write " + STATE + "/bots.tsv")
        print(SYNC_REFUSAL)
        return 1
    print("sync only runs from a guest with WAKE_HOSTOPS set (edit " + REGISTRY + " here)")
    return 0


def key_state(b):
    """ok = a readable key file here, locked = present but unreadable, none = not saved on this computer."""
    path = os.path.join(KEYS, b["id"] + ".key")
    if not os.path.exists(path):
        return "none"
    return "ok" if os.access(path, os.R_OK) else "locked"


def update_all(bots, source, ping, force):
    """--update: pull missing keys when a helper exists, then report key state per bot. A guest's
    registry push is refused (operator action); that makes the exit code 1."""
    rc = 0
    try:
        rc = sync_registry(show_rows=False)
    except SystemExit as e:
        print("registry sync failed: " + str(e)[:120])
        rc = 1
    me = own_bot(bots)
    print(f"{'ALIAS':<11} {'KIND':<8} {'KEY':<8} PING")
    for b in bots:
        ks = key_state(b)
        if ks == "none" and key_helper_available():
            try:
                ensure_key(b)
                ks = key_state(b)
            except SystemExit as e:
                ks = "elsewhere" if "made elsewhere" in str(e) else "error"
        pg = "-"
        if ping and ks == "ok" and b["kind"] == "open" and not (me and me["id"] == b["id"]):
            try:
                body = send(
                    b,
                    source,
                    "update-ping",
                    "ok",
                    "wake update ping, no reply needed",
                    "",
                    force,
                    quiet=True,
                    silent=operator_tone(),
                )
                pg = "ignored" if "ignored" in (body or "") else "sent"
            except SystemExit as e:
                pg = str(e)[:40]
        print(f"{b['alias']:<11} {b['kind']:<8} {ks:<8} {pg}")
    return rc


def message_all(bots, text, source, event, level, ref, force):
    """--all: one message to every open bot, never to the sender itself and never to a private bot."""
    sent = failed = 0
    for b in bots:
        if b["kind"] != "open" or source == "bot:" + b["alias"]:
            continue
        try:
            send(b, source, event, level, text, ref, force, quiet=True, silent=operator_tone())
        except SystemExit as e:
            failed += 1
            print(f"failed {b['alias']}: {str(e)[:120]}")
            continue
        sent += 1
        print(f"sent {b['alias']}")
    print(f"{sent} sent, {failed} failed")
    return 0 if failed == 0 else 1


# ---------- threads: one JSON object per line, shared on the host ----------


def tid_new():
    return f"{time.strftime('%m%d%H%M')}-{random.getrandbits(16):04x}"


def _host_run(cmd, data=None):
    """Write/read on the host from either side: a guest over HOSTOPS, the host directly."""
    if not in_container():
        return subprocess.run(["bash", "-lc", cmd], input=data, capture_output=True, text=True)
    return subprocess.run([HOSTOPS, cmd], input=data, capture_output=True, text=True)


def thread_append(tid, rec):
    line = json.dumps(rec, ensure_ascii=False) + "\n"
    path = q(f"{THREADS}/{tid}.jsonl")
    # The thread store is provisioned once on the host (root:wake 3770: setgid + sticky, so
    # only a file's owner may unlink it) and wake never changes its mode: re-applying 1777
    # on every append is what kept the store world-writable.
    cmd = (
        f"mkdir -p {q(THREADS)} 2>/dev/null || sudo mkdir -p {q(THREADS)}; "
        f"if [ -e {path} ]; then dd of={path} oflag=append conv=notrunc,nocreat status=none; "
        f"else cat >> {path}; fi"
    )
    try:
        r = _host_run(cmd, line)
    except OSError as e:
        sys.exit(f"cannot write thread {tid}: {e}")
    if r.returncode != 0:
        sys.exit(
            "cannot write thread "
            + tid
            + ": "
            + (r.stderr or r.stdout).strip()[-200:]
            + f" (the store {THREADS} must exist and be writable by this user: root:wake 3770, setgid + sticky)"
        )


def bridge_failed(r):
    """A failed call the host complained about (gate refused, ssh died), not an empty store: those print nothing."""
    return r.returncode != 0 and bool((getattr(r, "stderr", "") or "").strip())


def store_dir_entries(r):
    """The store directory's own entries from an `ls` result, or None when the directory itself
    cannot be read (#168).

    Every store command the client sends silences stderr, because that is the shape the host
    gate matches; the same silence throws away the reason a read failed. The one-call store read
    prints nothing both for a store with no files and for a store the shell could not enter, so
    an empty answer on its own cannot tell a quiet store from a broken one. `ls` is the command
    whose exit status carries the difference, and a listing of the store is a shape the gate
    already allows. A `threads` that is a regular file prints its own path and exits 0, which is
    the other way a broken store reads as an empty one. Both listings land here: the plain one
    from `threads_all_one_by_one` and the `ls -F` confirmation, whose entries keep a type mark
    that `entry_name` strips before the store path is compared.
    """
    if bridge_failed(r) or r.returncode != 0:
        return None
    out = (r.stdout or "").strip()
    if entry_name(out) == THREADS:
        return None
    return out.split()


def entry_name(entry):
    """One `ls -F` entry without its type mark: `stray.jsonl/` and `link.jsonl@` keep only the
    name. A plain `ls` entry carries no mark, so both listings answer here."""
    return entry[:-1] if entry and entry[-1] in "*/@=>|" else entry


def store_dir_unreadable():
    """True when the store directory cannot be entered, so an empty answer means nothing.

    Listing needs only `r` on the directory; the store read's glob needs `x` as well, so a
    `threads/` holding files at mode 444 or 644 prints every name while the one-call read
    prints nothing - the empty answer #168 is about, one permission bit further out (#177).
    So the listing is not just checked for a failure: a thread file there, with nothing read
    back, is a store that could not be entered. The listing asks `ls -F` for one reason: its
    type mark is appended to the name, so a directory (`stray.jsonl/`), a symlink, dangling or
    not (`link.jsonl@`), a fifo (`pipe.jsonl|`) and a socket (`s.jsonl=`) no longer end in
    `.jsonl`, and stop counting as a thread file the read should have returned. The store read
    keeps only regular files (`[ -f "$f" ] || continue`), so those entries are what it was right
    to leave out, and a store holding nothing but them is quiet, not unreadable (#186). An
    executable regular thread file wears the `*` mark too, but the read does not skip it: if it
    is readable the store read returned it and this question is never asked, and if it is not
    readable the one-by-one read fails and reports the store itself, so `*` needs no clause here.
    This runs only when the answer is already empty, so a store that answers with threads pays
    nothing for it.

    Two shapes follow from that. `ls -F` exits non-zero when it cannot stat what it lists -
    a 444 or 644 directory - which is the unenterable store itself. And a gate that predates
    this listing refuses the call with a message on stderr, which is what `bridge_failed`
    names, so the plain shape #177 shipped still answers: a gate learns the new route before
    this client ships, and until it does the old question is asked instead of guessing.
    """
    try:
        marked = _host_run(f"ls -F {q(THREADS)} 2>/dev/null")
    except OSError:
        return True
    if bridge_failed(marked):
        return store_dir_unreadable_plain()
    entries = store_dir_entries(marked)
    if entries is None:
        return True
    # Any mark left here is `/`, `@`, `|`, `=` or `>` - none of them a regular file, so none a
    # name the store read should have returned. The bare suffix is an entry `ls -F` could not
    # stat, which is a 444 directory's own answer and already returned None above.
    return any(e.endswith(".jsonl") for e in entries)


def store_dir_unreadable_plain():
    """The same question asked with `ls <store> 2>/dev/null`, the shape every gate allows.

    A gate that predates #186 refuses the marked listing, and the refusal is on stderr, so the
    client can tell it from a store that failed to list: here an entry ending in `.jsonl` is
    taken at face value, which is #177's answer and is still wrong for a `*.jsonl` directory
    on such a host until the gate route ships (#186).
    """
    try:
        entries = store_dir_entries(_host_run(f"ls {q(THREADS)} 2>/dev/null"))
    except OSError:
        return True
    if entries is None:
        return True
    return any(e.endswith(".jsonl") for e in entries)


def thread_read(tid):
    """One thread's records: [] when the thread does not exist, None when the store itself cannot be read."""
    if "/" in tid or ".." in tid:
        sys.exit("bad thread id")
    name = tid + ".jsonl"
    path = q(f"{THREADS}/{name}")
    try:
        r = _host_run(f"cat {path} 2>/dev/null")
        if bridge_failed(r):
            return None
        if r.returncode != 0:
            listing = _host_run(f"ls {q(THREADS)} 2>/dev/null")
            if bridge_failed(listing) or name in (listing.stdout or "").split():
                return None
    except OSError:
        return None
    return _recs(r.stdout)


def _recs(text):
    """The records in one thread file: a torn or hand-edited line is skipped, never fatal."""
    recs = []
    for ln in text.splitlines():
        try:
            recs.append(json.loads(ln))
        except Exception:
            pass
    return recs


def threads_all():
    """Every thread in the store as (tid, records), in one host call for the lot.

    `--inbox` used to call thread_read() once per file, and a guest pays 420-519 ms for every
    bridge call, so a 128-thread store cost 51 s and every thread anyone ever opened made it
    slower (#165). One command now prints a marker line and cats each file: a record is one
    JSON object per line, so a line that starts with the marker is never a record, and each
    cat reads whatever is there, so an append during the read tears nothing.

    A file this user cannot read prints a failure marker instead of vanishing: the read then
    returns None and the caller falls back to one thread per call, which reports the store as
    unreadable the way it always did. A short inbox must never hide a reply someone waits on.

    None when the store cannot be read at all: the caller reports that instead of an empty
    inbox, and reads one thread per call for a host whose gate predates this shape.
    """
    mark = "@@wake-file "  # a record is one JSON object per line, so this cannot begin one
    failed = "@@wake-fail "  # ditto: the loop prints it only when it could not read a file
    cmd = (
        "for f in " + q(THREADS) + '/*.jsonl; do [ -f "$f" ] || continue; '
        "printf '\\n" + mark + '%s\\n\' "${f##*/}"; '
        'cat "$f" || printf \'\\n' + failed + '%s\\n\' "${f##*/}"; done 2>/dev/null'
    )
    try:
        r = _host_run(cmd)
    except OSError:
        return None
    if bridge_failed(r) or r.returncode != 0:
        return None
    threads = []
    recs = None
    for line in (r.stdout or "").splitlines():
        if line.startswith(failed):
            return None  # one file could not be read: fail loud, never answer with a short inbox
        if line.startswith(mark):
            name = line[len(mark) :].strip()
            tid = name[: -len(".jsonl")] if name.endswith(".jsonl") else ""
            recs = [] if tid and "/" not in tid and ".." not in tid else None
            if recs is not None:
                threads.append((tid, recs))
            continue
        if recs is None:
            continue
        try:
            recs.append(json.loads(line))
        except Exception:
            pass
    return threads


def threads_all_one_by_one():
    """The pre-#165 read: one listing, then one host call per thread.

    The store-wide read is a command shape the host gate has to know. Until it does, a gated
    host refuses the one call, and this path answers in 420-519 ms per thread, as it always
    did: slow, never wrong.
    """
    try:
        r = _host_run(f"ls {q(THREADS)} 2>/dev/null")
    except OSError:
        return None
    entries = store_dir_entries(r)
    if entries is None:
        return None
    out = []
    for fn in entries:
        if not fn.endswith(".jsonl"):
            continue
        recs = thread_read(fn[:-6])
        if recs is None:
            return None
        out.append((fn[:-6], recs))
    return out


def threads_mine(sender):
    """Threads opened by `sender`, newest first; None when the store cannot be read."""
    threads = threads_all()
    if threads is None:
        threads = threads_all_one_by_one()
    if threads is None:
        return None
    if not threads and store_dir_unreadable():
        # Nothing came back: either the store holds no threads or it could not be entered, and
        # `--inbox` must never answer the second as the first (#168, #177). One extra call, paid
        # only when the answer is empty, in a shape the gate already allows, so no gate change.
        return None
    mine = [(tid, recs) for tid, recs in threads if recs and recs[0].get("from") == sender]
    return sorted(mine, key=lambda x: x[1][0].get("ts", ""), reverse=True)


def threads_addressed(sender):
    """Threads another bot opened for `sender` that nobody has answered yet, newest first (#242).

    `--inbox` lists what I asked; this lists what is waiting on me, which is how a silently
    queued message is found: it started no run, so the next turn has to look.
    """
    alias = sender.split(":", 1)[1] if ":" in sender else sender
    threads = threads_all()
    if threads is None:
        threads = threads_all_one_by_one()
    if threads is None:
        return None
    if not threads and store_dir_unreadable():
        # Same line as threads_mine: a store that could not be entered must never answer as an
        # empty one, or a silently queued message reads as "nothing is waiting" (#168, #177).
        return None
    waiting = []
    for tid, recs in threads:
        if not recs:
            continue
        head = recs[0]
        if head.get("to") != alias:
            continue
        if any(r.get("kind") == "reply" for r in recs):
            continue
        waiting.append((tid, recs))
    return sorted(waiting, key=lambda x: x[1][0].get("ts", ""), reverse=True)


# ---------- session inboxes: a live agent session reads these as its next message ----------
INBOX = STATE + "/inbox"
ACTIVE = INBOX + "/active"


def inbox_of_session():
    """The inbox of the agent session this shell belongs to, if any (the session extension exports WAKE_INBOX).
    The file lives on the host, so its existence is only checked when writing."""
    return os.environ.get("WAKE_INBOX", "")


def inbox_live():
    """Inboxes of sessions whose process is still running on the host (marker pid checked in /proc)."""
    r = _host_run(f"ls -t {q(ACTIVE)}/*.json 2>/dev/null | head -10")
    live = []
    for fn in (r.stdout or "").split():
        try:
            rec = json.loads(_host_run(f"cat {q(fn)} 2>/dev/null").stdout)
        except (OSError, ValueError):
            continue
        if rec.get("inbox") and rec.get("pid") and _host_run(f"test -d /proc/{int(rec['pid'])}").returncode == 0:
            live.append(rec["inbox"])
    return live


def inbox_active(recorded=""):
    """Where to deliver: the inbox recorded on the thread if that session is still running, else the one live session. Never guesses between two."""
    live = inbox_live()
    if recorded and recorded in live:
        return recorded
    return live[0] if len(live) == 1 else ""


def inbox_push(path, rec):
    if not path:
        return False
    line = json.dumps(rec, ensure_ascii=False) + "\n"
    r = _host_run(f"mkdir -p {q(INBOX)} 2>/dev/null; touch {q(path)}; cat >> {q(path)}", line)
    return r.returncode == 0


def show(recs, tid=""):
    if tid:
        print("thread " + tid)
    for r in recs:
        who = r.get("from", "?")
        print(f"[{r.get('ts', '')[:16]}] {who} ({r.get('kind', 'ask')}): {r.get('text', '')}")


# ---------- sending ----------


def key_helper_available():
    if HOSTOPS:
        return os.path.exists(HOSTOPS)
    try:
        exe = shlex.split(KEY_HELPER)[0]
    except (ValueError, IndexError):
        return False
    return shutil.which(exe) is not None


ROTATE_COOLDOWN_S = float(os.environ.get("WAKE_ROTATE_COOLDOWN", "600"))


def rotation_log():
    """Beside the keys, not in the host store: a guest reaches the host through an allow-list
    gate that admits the exact thread/inbox commands wake sends and nothing else, so a note
    written there would be refused exactly where a bot rotates a key. The cost is that the
    record is per key dir; a rotation run from the host and one run in a container keep
    separate logs, and the runbook's claim-the-ticket rule stays the cross-machine guard.
    """
    return os.path.join(KEYS, "wake-rotations.jsonl")


def last_rotation(bot_id):
    """The newest record for this bot in this key dir, or None.

    A rotation is invisible after the fact: the key file carries no history and the mint helper
    leaves no trace. On 2026-11-28 two runs rotated the same twelve keys six minutes apart, the
    second undid the key files the first had installed, and every send was refused until the
    files were rewritten by hand. This log is what lets the next rotation see the last one.
    """
    rec = None
    try:
        with open(rotation_log()) as f:
            for line in f:  # append-only, so the last match is the newest
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if row.get("bot") == bot_id and row.get("ts"):
                    rec = row
    except OSError:
        return None  # no log yet: a key from before this change must still rotate
    return rec


def rotation_age_hours(rec):
    try:
        return (time.time() - datetime.datetime.strptime(rec["ts"], "%Y-%m-%dT%H:%M:%S%z").timestamp()) / 3600
    except (KeyError, TypeError, ValueError):
        return None


def record_rotation(bot_id, key, action):
    """One line per mint: when, which bot, a sha256 prefix of the key, and the label that did it.

    Never the key. The note is best effort: a key dir that cannot be written must not fail a
    rotation that worked, so a failed write stays silent, like the audit log.
    """
    rec = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "bot": bot_id,
        "action": action,
        "sha256_12": hashlib.sha256(key.strip().encode()).hexdigest()[:12],
        "source": default_source(),
        "user": os.environ.get("USER", "?"),
        "uid": os.getuid(),
        "host": os.uname().nodename,
    }
    try:
        fd = os.open(rotation_log(), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps(rec) + "\n")
    except OSError:
        pass  # a note that cannot be saved must not fail a rotation that worked


def ensure_key(b, rotate=False):
    path = f"{KEYS}/{b['id']}.key"
    if os.path.exists(path) and not rotate:
        return path
    no_key = (
        f"{b['name']} has no wake key yet ({path} is missing) and this account cannot create one. "
        f"Ask an admin of the host to run: wake --setup {b['alias']}"
    )
    if not key_helper_available():
        sys.exit(no_key)
    if rotate:
        prev = last_rotation(b["id"])
        age = rotation_age_hours(prev) if prev else None
        again = os.environ.get("WAKE_ROTATE_AGAIN", "").strip() == "1"
        if age is not None and age * 3600 < ROTATE_COOLDOWN_S and not again:
            sys.exit(
                f"{b['name']}'s key was rotated {max(1, int(age * 60))} min ago ({prev.get('ts', '?')}) by "
                f"{prev.get('source', '?')} on {prev.get('host', '?')} ({prev.get('sha256_12', '?')}); "
                f"every machine still holding "
                f"the old key is refused until its key dir is refreshed (wake-keys). Not rotating again. "
                f"Set WAKE_ROTATE_AGAIN=1 if a second rotation really is intended."
            )
    try:
        rc, out, err = host(f"{KEY_HELPER} has-key {q(b['id'])}")
    except (subprocess.CalledProcessError, OSError):
        sys.exit(no_key)
    if rc != 0:
        sys.exit(f"cannot reach host: {err[-200:]}")
    if out == "yes" and not rotate:
        sys.exit(
            f"{b['name']} already has a key made elsewhere and none is saved here. Run: wake --setup {b['alias']} --rotate (old key stops working)"
        )
    rc, out, err = host(f"{KEY_HELPER} {q(b['id'])}" + (" --rotate" if rotate else ""))
    if rc != 0 or not out:
        sys.exit(f"key creation failed: {err[-200:]}")
    os.makedirs(KEYS, mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(out + "\n")
    record_rotation(b["id"], out, "rotate" if rotate else "create")
    rc, out, err = host(f"{KEY_HELPER} enable-bot {q(b['id'])}")
    print(f"created key for {b['name']}; routines enabled: {out}")
    return path


MAX_DEPTH = 2  # a wake started by a wake started by a wake is refused
HOURLY_CAP = 30  # per target bot, per user
REPLY_TTL_H = float(os.environ.get("WAKE_TTL_HOURS", "24"))  # older threads refuse answers (0 = off)


def audit_file():
    return os.path.join(CFG["WAKE_RATE_DIR"], f"wake-audit-{os.getuid()}.log")


def audit(cmd, source, text, tid="", bot="", rc=0):
    """One line per ask, reply and refusal, so a refusal leaves a trace instead of looking like a delivered answer."""
    try:
        with open(audit_file(), "a") as f:
            f.write(
                json.dumps(
                    {
                        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                        "cmd": cmd,
                        "source": source,
                        "bot": bot,
                        "thread": tid,
                        "rc": rc,
                        "text": text[:200],
                    },
                    ensure_ascii=False,
                )
                + "\n"
            )
    except OSError:
        pass


def age_hours(ts):
    try:
        return (time.time() - datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S%z").timestamp()) / 3600
    except (TypeError, ValueError):
        return None


def rate_file():
    return os.path.join(CFG["WAKE_RATE_DIR"], f"wake-rate-{os.getuid()}.json")


def guard(b, force):
    """Loop guard. Depth comes from WAKE_DEPTH (wake-run raises it for child commands); rate from a per-uid local log."""
    depth = int(os.environ.get("WAKE_DEPTH", "0") or 0)
    if depth >= MAX_DEPTH and not force:
        sys.exit(f"refused: wake depth {depth} >= {MAX_DEPTH} (loop guard). Use --force only if you are sure.")
    path = rate_file()
    now = time.time()
    try:
        log = json.load(open(path))
    except Exception:
        log = {}
    hits = [t for t in log.get(b["id"], []) if now - t < 3600]
    if len(hits) >= HOURLY_CAP and not force:
        sys.exit(
            f"refused: {len(hits)} wakes to {b['alias']} in the last hour (cap {HOURLY_CAP}). Use --force to override."
        )
    log[b["id"]] = hits + [now]
    json.dump(log, open(path, "w"))
    return depth


def read_key(path):
    """Read a wake key; a long-running session that predates its wake-group membership retries through sg."""
    try:
        return open(path).read().strip()
    except PermissionError:
        r = subprocess.run(["sg", GROUP, "-c", "cat " + q(path)], capture_output=True, text=True)
        if r.returncode:
            sys.exit(
                f"cannot read {path}: permission denied, and `sg {GROUP}` failed too. "
                f"Add this user to group {GROUP!r} (then start a new login) or ask an admin."
            )
        return r.stdout.strip()


def send(b, source, event, level, detail, ref, force=False, quiet=False, silent=None):
    if silent is None:
        silent = tone_for(source)
    # A wake labelled with the recipient's own alias is a bot waking itself: the run it starts is the
    # one already sending, and in a shared home the `self` file can name a bot this shell is not, so
    # the label is as likely to be an accident as a request (#455).
    if source == "bot:" + b["alias"] and not force:
        sys.exit(
            source + " is the alias of " + b["name"] + ", the bot this wake is addressed to, so it"
            " would wake itself: a run cannot ask the run it is already in, and in a shared home the"
            " `self` file can name the wrong bot. Name the bot to reach, or --force to send anyway."
        )
    if not BASE:
        sys.exit("WAKE_API_BASE is not set (env or config.env), e.g. https://bots.example.com/api/v1/bots")
    depth = guard(b, force)
    key = read_key(ensure_key(b))
    message = detail
    detail = (detail + " | " + context()).strip(" |")
    if silent:
        detail = detail + " | " + SILENT_TAIL
    # The sending bot's id lets the chats show the message as one bot to another. A label, not proof.
    sender = next((x for x in load() if "bot:" + x["alias"] == source), None) if os.path.exists(REGISTRY) else None
    # An agent outside the bot fleet (skill:omp, harness:x) shows under its own name, never as a bot.
    kind, _, label = source.partition(":")
    agent = AGENT_NAMES.get(label, label) if kind in ("skill", "harness") and label else ""
    payload = {
        "depth": depth,
        "source": source,
        **({"fromBotId": sender["id"]} if sender else {}),
        **({"fromAgent": agent} if agent and not sender else {}),
        "message": message,
        "event": event,
        "level": level,
        "silent": bool(silent),
        "detail": detail,
        "ref": ref,
        "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    }
    if len(json.dumps(payload).encode()) > PAYLOAD_MAX:
        # The chip is display text and the receiver falls back to `detail`; a lost wake is worse.
        payload.pop("message", None)
    idem = hashlib.sha256(f"{b['id']}|{source}|{event}|{detail}|{int(time.time() // 600)}".encode()).hexdigest()[:32]
    req = urllib.request.Request(
        f"{BASE}/{b['id']}/webhook",
        data=json.dumps(payload).encode(),
        method="POST",
        headers={
            "Authorization": "Bearer " + key,
            "Content-Type": "application/json",
            "Idempotency-Key": idem,
            "User-Agent": "wake-cli/" + wake_config.VERSION,
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            body = r.read().decode()
            if not quiet:
                print(f"woke {b['name']}: {r.status} {body[:200]}")
            return body
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:200]
        hint = {
            401: f" (key rejected; try wake --setup {b['alias']} --rotate)",
            404: " (no enabled webhook routine on that bot; ask an admin to enable one)",
        }.get(e.code, "")
        sys.exit(f"{e.code} {body}{hint}")
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach {BASE}: {e.reason}")


def queue_silent(b, text, source, kind="note", what="message"):
    """Record a message for a bot and ring nothing, so no run starts and no chat line can appear.

    A wake is a Rakazo run, and a run's final answer is posted into the recipient's chat: the
    platform decides that, not the payload, and a model always produces a final message, so
    "answer without posting" is only ever a prompt (#242). The one structural answer is to start
    no run. The record still lands in the shared store and the recipient finds it with
    `wake --pending`; the cost is latency, paid in exchange for a guarantee.
    """
    tid = tid_new()
    thread_append(
        tid,
        {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "from": source,
            "owner": source,
            "reply_to": "bot:" + b["alias"],
            "kind": kind,
            "text": text,
            "to": b["alias"],
            "inbox": inbox_of_session(),
            "silent": True,
        },
    )
    audit("silent", source, text, tid, b["alias"], 0)
    print(
        f"queued silently: {what} in thread {tid} for {b['alias']} - no run started, so nothing posts to"
        " its chat; it finds it with wake --pending"
    )
    return tid


def ask(b, text, wait, level, source, force, no_send=False, silent=False):
    if silent:
        # A silent ask is the same record a loud one writes, minus the doorbell: it waits for the
        # recipient's next turn instead of starting one (#242).
        queue_silent(b, text, source, kind="ask")
        return 0
    tone = tone_for(source)
    tid = tid_new()
    thread_append(
        tid,
        {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "from": source,
            "owner": source,
            "reply_to": "bot:" + b["alias"],
            "kind": "ask",
            "text": text,
            "to": b["alias"],
            "inbox": inbox_of_session(),
            "silent_payload": tone,
        },
    )
    detail = f'{text} [thread {tid}] reply: wake --reply {tid} "YOUR ANSWER"'
    if not no_send:
        send(b, source, "request", level, detail, "thread:" + tid, force, silent=tone)
    else:
        print(f"[dry-run] would ask {b['alias']}: {detail}")
    audit("ask", source, text, tid, b["alias"], 99 if no_send else 0)
    print(f"thread {tid} opened with {b['alias']}" + (f"; waiting up to {wait}s" if wait else ""))
    if not wait:
        return 0
    end = time.time() + wait
    while time.time() < end:
        time.sleep(3)
        recs = thread_read(tid)
        if recs is None:
            print(f"thread store unreachable while waiting; read it later with: wake --thread {tid}")
            return 3
        answers = [r for r in recs if r.get("kind") == "reply"]
        if answers:
            show(answers, tid)
            return 0
    print(f"no reply yet from {b['alias']}; read it later with: wake --thread {tid}")
    return 3


API_THREAD_ID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")


def api_thread_refusal(tid):
    """The API mints UUID thread ids in Postgres; this CLI reads only the shared folder, so its
    "never opened" text is wrong for one: name the store the id belongs to, the route that can
    answer it, and the setting this shell is missing when it cannot (issue #96). None for a
    CLI-shaped id, so that message stays as it was."""
    if not API_THREAD_ID.match(tid):
        return None
    token = (CFG.get("WAKE_AGENT_TOKEN") or "").strip()
    reply_token = (CFG.get("WAKE_REPLY_TOKEN") or "").strip()
    base = (CFG.get("WAKE_API") or "").strip()
    missing = [
        name
        for name, value in (
            (
                "WAKE_AGENT_TOKEN (the token of this bot) or WAKE_REPLY_TOKEN (the token the doorbell payload carried)",
                token or reply_token,
            ),
            ("WAKE_API (for example http://127.0.0.1:3001)", base),
        )
        if not value
    ]
    why = ""
    if missing:
        them = "them" if len(missing) > 1 else "it"
        why = (
            f" This shell has no {' and '.join(missing)}, so wake cannot answer there either; set {them} in config.env."
        )
    return (
        f"no thread {tid} in the shared-folder store at {THREADS}: that id belongs to a thread the "
        f"wake API opened, which that store cannot show. Answer it on the API: "
        f"POST /threads/{tid}/reply with an agent token or the thread's reply token "
        f"(MCP clients: the wake_reply tool).{why} "
        f"CLI threads have ids like 1114-a3f2."
    )


def api_reply(tid, text):
    """Answer an API thread on the API. (None, None) when this CLI holds no credential for it,
    so the caller can name what is missing instead of guessing.

    Two credentials can answer: this bot's own agent token, or the per-thread reply token the
    doorbell payload carried (#93) - a doorbell-woken bot has no agent token, and the token is
    scoped to that one thread, usable once, and expires with the thread. The bearer wins when both
    are set, so only one credential travels, in a header, never in argv: a process listing cannot
    leak it.

    The shared `mcp` token cannot stand in: it is one identity, the route refuses the asker of an
    ask (apps/api/src/threads.ts), and every MCP-born thread has that identity as its asker.
    """
    token = (CFG.get("WAKE_AGENT_TOKEN") or "").strip()
    reply_token = (CFG.get("WAKE_REPLY_TOKEN") or "").strip()
    base = (CFG.get("WAKE_API") or "").strip().rstrip("/")
    if not base or not (token or reply_token):
        return None, None
    headers = {
        "Content-Type": "application/json",
        "User-Agent": "wake-cli/" + wake_config.VERSION,
    }
    if token:
        headers["Authorization"] = "Bearer " + token
    elif reply_token:
        headers["X-Wake-Reply-Token"] = reply_token
    req = urllib.request.Request(
        f"{base}/threads/{urllib.parse.quote(tid)}/reply",
        data=json.dumps({"body": text}).encode(),
        method="POST",
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        raw = e.read().decode()
        try:
            message = json.loads(raw).get("error") or raw
        except (ValueError, AttributeError):
            message = raw
        return e.code, message[:300]
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach the wake API at {base} to answer {tid}: {e.reason}")


def api_read_credential():
    """(base, auth headers) for reading threads on the API, or (None, None) when this shell holds
    no credential at all.

    A bot reads with its own agent token, or - when it holds none - with the per-thread reply token
    the wake payload carried: the API accepts that token on the one thread it names, for reading it
    and for marking it read (#322). A reply token names a single thread and cannot enumerate, so
    the routes that list (GET /threads, GET /inbox) still need the agent token; api_thread_rows
    refuses to pretend otherwise. Only one credential travels, in a header, never in argv.
    """
    base = (CFG.get("WAKE_API") or "").strip().rstrip("/")
    token = (CFG.get("WAKE_AGENT_TOKEN") or "").strip()
    reply_token = (CFG.get("WAKE_REPLY_TOKEN") or "").strip()
    if not base or not (token or reply_token):
        return None, None
    if token:
        return base, {"Authorization": "Bearer " + token}
    return base, {"X-Wake-Reply-Token": reply_token}


def api_alias(bots, source):
    """This shell's own name on the wake API, or None when the shell is nobody's bot.

    The API registers an agent under the alias the fleet uses ("engineer", "potato"), and a bot's
    WAKE_SOURCE carries that same alias, so the alias is the one name both sides agree on.
    """
    if source.startswith("bot:"):
        return source.split(":", 1)[1]
    b = own_bot(bots)
    return b["alias"] if b else None


def api_get(base, auth, path):
    """GET one API route as this bot, with the credential api_read_credential chose. (status, body)
    for an answer the API gave, (None, reason) when it could not be reached at all: an unreachable
    API must never read as an empty list."""
    req = urllib.request.Request(
        base + path,
        method="GET",
        headers={**auth, "User-Agent": "wake-cli/" + wake_config.VERSION},
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.loads(r.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        raw = e.read().decode()
        try:
            message = json.loads(raw).get("error") or raw
        except (ValueError, AttributeError):
            message = raw
        return e.code, message[:300]
    except urllib.error.URLError as e:
        return None, str(e.reason)
    except OSError as e:
        return None, str(e)


def api_read_missing(tid):
    """What to say when an API-shaped id is not in the folder and this shell cannot ask the API."""
    return (
        f"no thread {tid} in the shared-folder store at {THREADS}: that id belongs to a thread the "
        f"wake API opened, which that store cannot show. Read it on the API: GET /threads/{tid} as "
        f"this bot, which needs WAKE_API and either WAKE_AGENT_TOKEN or the thread's own reply "
        f"token in WAKE_REPLY_TOKEN (the wake payload carries it) in config.env."
    )


def api_refusal(status, body, what):
    """One refusal in the terms this bot can act on. "what" is what was asked for, already worded:
    "thread <id>", or "the thread list"."""
    if status == 401:
        return (
            f"the wake API refused the token in WAKE_AGENT_TOKEN (401) for {what}: it is not a live "
            f"agent token for this bot."
        )
    if status == 404:
        return f"the wake API answered 404 for {what}: it was never opened, or this bot is not one of its participants."
    return f"the wake API refused {what}: {status} {body}"


def api_thread_recs(thread):
    """One API thread as the records the flat store holds, so show() renders both the same way.

    The API keeps a thread's messages in order under a per-thread seq; the first one opened the
    thread, so it is the ask and every later one is a reply (#102).
    """
    recs = []
    for m in thread.get("messages") or []:
        recs.append(
            {
                "from": m.get("from", "?"),
                "kind": "ask" if m.get("seq", 0) == 1 else "reply",
                "text": m.get("body", ""),
                "ts": m.get("createdAt", ""),
            }
        )
    return recs


def api_missing_hint(alias):
    """The sentence an empty view earns when this shell cannot ask the API at all.

    Empty when it can, or when there is no alias to ask as. An empty folder must never read as
    "nothing was opened anywhere": naming the setting that is missing is what tells the two apart
    (#101, #102).
    """
    if not alias:
        return ""
    base, auth = api_read_credential()
    if base and auth:
        return ""
    missing = [name for name, value in (("WAKE_AGENT_TOKEN", base and auth), ("WAKE_API", base)) if not value]
    return (
        " (this shell holds no " + " and no ".join(missing) + ", so a thread opened on the wake API "
        "cannot be listed here)"
    )


def api_thread_rows(alias):
    """The threads this bot takes part in on the wake API, newest first, or None when this shell
    holds no agent token (the folder is then the only view there is).

    Raises SystemExit with the reason when the API was asked and refused: an inbox that could not
    be read must never print as an empty one (#101, #168, #177).
    """
    base, auth = api_read_credential()
    # Only an agent token can list: a reply token names one thread, and asking /threads with it
    # would earn a 401 that reads like a broken token rather than a credential that cannot list.
    if not base or not auth or "Authorization" not in auth:
        return None
    status, body = api_get(base, auth, "/threads?limit=100")
    if status is None:
        sys.exit(f"cannot reach the wake API at {base} to list threads: {body}")
    if status != 200:
        sys.exit(api_refusal(status, body, f"the thread list of {alias}"))
    return [t for t in body.get("threads") or [] if isinstance(t, dict)]


def reply(tid, text, source, notify, force, silent=False, notify_explicit=False, no_ring=False, chatty=False):
    recs = thread_read(tid)
    if recs is None:
        sys.exit(
            f"cannot read the thread store at {THREADS}, so {tid} cannot be answered: "
            f"check WAKE_HOSTOPS (guest) and that the directory is readable."
        )
    if not recs:
        # An id the API minted belongs to the API's store, not this folder: answer it there when
        # this bot holds its own token, and name the setting that is missing when it does not.
        if API_THREAD_ID.match(tid):
            # The API's reply route has no tone: it rings the asker whatever the caller wanted, and
            # its doorbell payload carries no `silent` key (apps/api/src/doorbell.ts). A flag that
            # promises no run, no ring or a quiet payload cannot be honoured here, so it is refused
            # before anything is posted rather than dropped after the asker was already rung (#382).
            if silent or no_ring:
                flag = "--silent" if silent else "--no-ring"
                audit("reply-refused", source, text, tid, "api", 8)
                sys.exit(
                    f"thread {tid} lives on the wake API, whose reply route always rings the asker: "
                    f"{flag} cannot be honoured there, so nothing was sent. Answer it without {flag}, "
                    f"or have the API grow a quiet reply."
                )
            status, answer = api_reply(tid, text)
            if status is not None:
                if status == 201:
                    seq = answer.get("seq", "?") if isinstance(answer, dict) else "?"
                    audit("reply", source, text, tid, "api", 0)
                    print(f"replied on thread {tid} through the wake API (seq {seq}): {text}")
                    if chatty:
                        print(
                            "  --chatty: the API reply is loud already (its payload carries no silent "
                            "field), so the flag changes nothing here"
                        )
                    return 0
                audit("reply-refused", source, text, tid, "api", 7)
                sys.exit(f"the wake API refused the reply to {tid}: {status} {answer}")
        audit("reply-refused", source, text, tid, rc=4)
        sys.exit(
            api_thread_refusal(tid)
            or (
                f"no thread {tid}: it was never opened, so there is nothing to answer. "
                f'A question thread is created by: wake --ask <bot> "<question>" (checked {THREADS}). '
                f"To reach that sender directly, wake the bot instead."
            )
        )
    head = recs[0]
    owner = head.get("owner") or head.get("from", "")
    reply_to = head.get("reply_to") or ("bot:" + head["to"] if head.get("to") else "")
    answers = [r for r in recs if r.get("kind") == "reply"]
    if REPLY_TTL_H and not force:
        ah = age_hours(head.get("ts", ""))
        if ah is not None and ah > REPLY_TTL_H:
            audit("reply-refused", source, text, tid, reply_to, 5)
            sys.exit(
                f"thread {tid} is {ah:.0f}h old (TTL {REPLY_TTL_H:g}h): the asker has moved on, so this answer would land unread. "
                f'Open a new one with wake --ask <bot> "..." (--force to answer anyway)'
            )
    if answers and source == owner and not force:
        audit("reply-refused", source, text, tid, reply_to, 6)
        sys.exit(
            f"thread {tid} already has its answer from {answers[0].get('from', '?')}: one round only, so A to B to A cannot ping-pong. "
            f"Ask again with wake --ask ... if you need more (--force to override)"
        )
    # A thread opened silently was opened on the silent channel, so its answer rides the same one
    # unless the replier asks for a ring: otherwise the answer starts a run and posts a chat line,
    # which is the whole cost --silent was chosen to avoid (#242).
    if head.get("silent") is True and not notify_explicit:
        silent = True
    mine_inbox = os.environ.get("WAKE_INBOX", "")
    is_target = bool(reply_to) and source == reply_to
    # A label is not proof: --source is free text, so any bot can claim human:joshua. The owner's own
    # label and the session that opened the thread are the only two identities this store has, so an
    # answer of a different kind than the owner (a harness or a bot answering a human) has to come
    # from that session, and --force is the way past it (#455).
    is_owner = source == owner or (bool(mine_inbox) and mine_inbox == head.get("inbox"))
    if not (is_target or is_owner) and not force:
        sys.exit(
            f"thread {tid} is owned by {owner} and replies go to {reply_to}; {source} is neither, so it cannot answer. Use --force to override."
        )
    # The tone travels with the thread, not with the replier: the asker set it, and --chatty is the
    # only way to disagree. It is a different flag from silent, which starts no run at all.
    asked = head.get("silent_payload")
    tone = bool(tone_for(owner) if asked is None else asked) and not chatty
    thread_append(
        tid,
        {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "from": source,
            "kind": "reply",
            "text": text,
            "silent_payload": tone,
        },
    )
    audit("reply", source, text, tid, reply_to, 0)
    print(f"replied on thread {tid} (owner {owner}, reply_to {reply_to}): {text}")
    ts = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    if is_target:
        if owner.startswith("bot:") and owner[4:] not in ("container", source[4:]):
            tgt = resolve(owner[4:], load())
            if tgt and notify:
                if silent:
                    queue_silent(tgt, f"reply on thread {tid}: {text}", source, kind="reply", what="reply")
                elif no_ring:
                    # A ring starts a run on the asker, and a run's answer is the one leg no flag can
                    # hide. Unrung the reply waits in the store: no run, so nothing to render.
                    print(f"  no ring (--no-ring): {owner} reads it with: wake --thread {tid}  (or --inbox)")
                else:
                    send(
                        tgt,
                        source,
                        "reply",
                        "info",
                        f"reply on thread {tid}: {text}",
                        "thread:" + tid,
                        force,
                        silent=tone,
                    )
        else:
            box = inbox_active(head.get("inbox") or "")
            if inbox_push(box, {"from": source, "kind": "reply", "thread": tid, "text": text, "ts": ts}):
                print(f"  delivered into the owner's session ({box}) as its next message")
            else:
                print("  no live session inbox found; the owner reads the thread with: wake --thread " + tid)
    else:
        tgt = resolve(reply_to[4:], load()) if reply_to.startswith("bot:") else None
        if tgt:
            if silent:
                queue_silent(
                    tgt,
                    f"answer on thread {tid} from {source} (no reply needed): {text}",
                    source,
                    kind="reply",
                    what="reply",
                )
            elif no_ring:
                print(f"  no ring (--no-ring): {reply_to} reads it with: wake --thread {tid}  (or --inbox)")
            else:
                send(
                    tgt,
                    source,
                    "reply",
                    "info",
                    f"answer on thread {tid} from {source} (no reply needed): {text}",
                    "",
                    force,
                    silent=tone,
                )
                print(f"  woke {reply_to} with the reply")
    return 0


p = argparse.ArgumentParser(description="Wake or ask a bot. wake [bot] [message...]. No args = interactive picker.")
p.add_argument("--version", action="version", version="wake " + wake_config.VERSION)
p.add_argument("target", nargs="?")
p.add_argument("message", nargs="*")
p.add_argument("--list", action="store_true", help="all bots with role")
p.add_argument("--info", metavar="BOT", help="who a bot is, its role, and how to reach it")
p.add_argument("--me", action="store_true", help="which bot this shell is inside, from the registry")
p.add_argument("--ask", metavar="BOT", help="ask a bot and record a thread; --wait N blocks for its reply")
p.add_argument("--wait", type=int, default=0, metavar="SECONDS")
p.add_argument("--reply", nargs="+", metavar="THREAD_ID TEXT", help='answer a thread: wake --reply <id> "<text>"')
p.add_argument("--thread", metavar="ID", help="show one thread")
p.add_argument("--inbox", action="store_true", help="my threads and their answers")
p.add_argument("--notify", action="store_true", help="wake the asker bot when replying (default for bot askers)")
p.add_argument("--no-send", action="store_true", help="record the thread without sending (tests)")
p.add_argument(
    "--silent",
    action="store_true",
    help="record the message (or --reply) and start no run: nothing can post to the recipient's chat, it reads it with --pending",
)
p.add_argument("--pending", action="store_true", help="threads waiting on me: addressed to me, no reply yet")
p.add_argument(
    "--no-ring",
    dest="no_ring",
    action="store_true",
    help="reply without waking the asker: the answer waits in the thread store, so no run starts",
)
p.add_argument(
    "--chatty",
    action="store_true",
    help=(
        "let the receiver post its answer in its chat (payload silent=false). The default follows the "
        "sender: chatty from human:, silent from a bot or agent session"
    ),
)
p.add_argument("--setup", metavar="BOT", help="create (or with --rotate, replace) the webhook key for a bot")
p.add_argument("--rotate", action="store_true")
p.add_argument("--level", default="info", choices=["ok", "error", "info"])
p.add_argument("--event", default="message")
p.add_argument("--ref", default="")
p.add_argument("--source", default=None, help="sender label kind:name (default: WAKE_SOURCE, own bot, or human:$USER)")
p.add_argument("--allow-private", action="store_true")
p.add_argument("--force", action="store_true", help="skip loop guard")
p.add_argument("--sync", action="store_true", help="push the bot list to the host copy")
p.add_argument("--who", nargs="+", metavar="WORD", help="list bots whose role matches these words")
p.add_argument(
    "--add", nargs="+", metavar="ROW", help="add a bot row: ALIAS ID NAME KIND(open|private) [ROLE] and sync"
)
p.add_argument(
    "--update",
    action="store_true",
    help="sync the registry, then report every bot's key state (add --ping to wake each open bot)",
)
p.add_argument(
    "--ping", action="store_true", help="with --update: send a quiet ping to every open bot that has a readable key"
)
p.add_argument("--all", metavar="MESSAGE", help="send one message to every open bot (private bots are skipped)")
a = p.parse_args()
if a.chatty:
    SILENT = False
bots = load()
if a.source is None:
    a.source = default_source()

if a.silent and (a.all or a.ping or a.update or not (a.target or a.ask or a.reply)):
    sys.exit("--silent takes one target bot (or one --reply): it writes one thread and rings nothing")

if a.silent and a.wait:
    sys.exit("--silent starts no run, so --wait would wait on a bot that was never woken")

# --notify and --no-ring are the two halves of one decision about the same ring, so a caller that
# passes both has said nothing: the reply either wakes the asker or waits in the store. --no-ring
# used to win silently (#382).
if a.notify and a.no_ring:
    sys.exit(
        "--notify and --no-ring contradict each other: --notify rings the asker, --no-ring leaves the "
        "answer in the thread store and rings nobody. Pass one of them."
    )

if a.no_ring and not a.reply:
    sys.exit("--no-ring only applies to --reply: it leaves the answer in the thread store instead of waking the asker")

if a.add or a.sync:
    if a.add:
        if len(a.add) not in (4, 5):
            sys.exit("usage: wake --add ALIAS ID NAME KIND(open|private) [ROLE]")
        al, bid, nm, kd = a.add[:4]
        if kd not in ("open", "private") or any(x["alias"] == al or x["id"] == bid for x in bots):
            sys.exit("bad kind or alias/id already listed")
        with open(REGISTRY, "a") as f:
            f.write("\t".join(a.add) + "\n")
    sys.exit(sync_registry())

if a.update or a.ping:
    if a.ping and not a.update:
        sys.exit("--ping only makes sense with --update")
    sys.exit(update_all(bots, a.source, a.ping, a.force))

if a.all:
    sys.exit(message_all(bots, a.all, a.source, a.event, a.level, a.ref, a.force))

if a.list or a.who:
    hits = by_role(a.who, bots) if a.who else bots
    if a.who and not hits:
        print("no bot has that role; run `wake --list`")
        sys.exit(1)
    if a.who:
        for b in hits:
            print(f"{b['alias']}\t{b['name']}\t{b['role']}")
        sys.exit(0)
    print(f"{'ALIAS':<11} {'BOT':<34} {'KIND':<8} ROLE")
    for b in bots:
        print(f"{b['alias']:<11} {b['name']:<34} {b['kind']:<8} {b['role']}")
    sys.exit(0)

if a.info:
    b = resolve(a.info, bots)
    if not b:
        hits = by_role(a.info.replace(",", " ").split(), bots)
        if len(hits) == 1:
            b = hits[0]
        elif hits:
            print("more than one bot matches; say which:")
            for h in hits:
                print(f"  {h['alias']:<11} {h['name']:<30} {h['role'][:90]}")
            sys.exit(0)
        else:
            sys.exit(f"no bot {a.info!r}; try `wake --list`")
    print(f"{b['alias']} · {b['name']}")
    print(f"  id       {b['id']}")
    print(
        f"  kind     {b['kind']}"
        + ("  (never in group chats; material stays with its owner)" if b["kind"] == "private" else "")
    )
    print(f"  role     {b['role'] or 'not set'}")
    print(f'  reach    wake {b["alias"]} "<message>"      ask: wake --ask {b["alias"]} "<question>" --wait 180')
    print(
        f"  private  {'yes: add --allow-private, and only for real material it owns' if b['kind'] == 'private' else 'no'}"
    )
    sys.exit(0)

if a.me:
    b = own_bot(bots)
    print("shell context: " + context())
    if b:
        print(f"this shell runs inside {b['alias']} · {b['name']} ({b['id']})")
        print("  role     " + (b["role"] or "not set"))
        print("  kind     " + b["kind"])
        print("  as       " + a.source + "  (bots use their own alias; a coding harness sets WAKE_SOURCE)")
    else:
        print("not inside a bot computer: a human or harness shell, so wakes are sent as " + a.source)
        print("  to be treated as a bot, or as an agent harness, set WAKE_SOURCE=bot:<alias> or skill:<name>")
        print(
            "  a harness that always runs from the same computer can write its alias to "
            + os.path.join(CFG["WAKE_CONFIG_DIR"], "self")
        )
    sys.exit(0)

if a.pending:
    waiting = threads_addressed(a.source)
    if waiting is None:
        sys.exit(
            f"cannot read the thread store at {THREADS}: check WAKE_HOSTOPS (guest) and that the directory is readable."
        )
    api_waiting = []
    alias = None
    if not waiting:
        # Nothing in the folder, so ask the API what is waiting on this bot there (#102).
        alias = api_alias(bots, a.source)
        if alias:
            api_waiting = [
                t for t in api_thread_rows(alias) or [] if t.get("createdBy") != alias and (t.get("unread") or 0) > 0
            ]
    if not waiting and not api_waiting:
        print(f"nothing is waiting on {a.source}{api_missing_hint(alias)}")
        sys.exit(0)
    for tid, recs in waiting:
        head = recs[0]
        print(f"{tid}  from {head.get('from', '?')}  ({head.get('kind', 'ask')})  | {head.get('text', '')[:70]}")
        for r in recs[1:]:
            print(f"    [{r.get('from')}] {r.get('text', '')}"[:300])
        print("    answer with: wake --reply " + tid + ' "<answer>"')
    for t in api_waiting:
        tid = str(t.get("id", "?"))
        print(
            f"{tid}  from {t.get('createdBy', '?')}  ({t.get('kind', 'ask')})  "
            f"{t.get('unread', 0)} unread  | {t.get('status', '?')}"
        )
        print("    read it with: wake --thread " + tid + ", answer with: wake --reply " + tid + ' "<answer>"')
    if api_waiting:
        print(f"(wake API: {len(api_waiting)} waiting on {alias})")
    sys.exit(0)
if a.thread:
    recs = thread_read(a.thread)
    if recs is None:
        sys.exit(
            f"cannot read the thread store at {THREADS}: check WAKE_HOSTOPS (guest) and that the directory is readable."
        )
    api_note = ""
    if not recs and API_THREAD_ID.match(a.thread):
        # The id is the API's, so the folder never held it: read it where it lives (#102).
        base, auth = api_read_credential()
        if not base or not auth:
            sys.exit(api_read_missing(a.thread))
        status, body = api_get(base, auth, "/threads/" + urllib.parse.quote(a.thread))
        if status is None:
            sys.exit(f"cannot reach the wake API at {base} to read thread {a.thread}: {body}")
        if status != 200:
            sys.exit(api_refusal(status, body, f"thread {a.thread}"))
        recs = api_thread_recs(body)
        api_note = f"(read from the wake API: {len(recs)} message(s), thread {body.get('status', '?')})"
    if not recs:
        sys.exit(f"no thread {a.thread}")
    show(recs, a.thread)
    if api_note:
        print(api_note)
    sys.exit(0)
if a.inbox:
    mine = threads_mine(a.source)
    if mine is None:
        sys.exit(
            f"cannot read the thread store at {THREADS}: check WAKE_HOSTOPS (guest) and that the directory is readable."
        )
    opened = []
    alias = None
    if not mine:
        # The folder is the source of truth while it has rows; an empty one is where an API thread
        # would be missing, so list those too (#102).
        alias = api_alias(bots, a.source)
        if alias:
            opened = [t for t in api_thread_rows(alias) or [] if t.get("createdBy") == alias]
    if mine:
        for tid, recs in mine:
            answers = [r for r in recs if r.get("kind") == "reply"]
            state = f"{len(answers)} reply" if answers else "no reply yet"
            print(f"{tid}  to {recs[0].get('to', '?')}  {state}  | {recs[0].get('text', '')[:70]}")
            for r in answers:
                print(f"    [{r.get('from')}] {r.get('text')}"[:300])
    elif opened:
        for t in opened:
            names = ", ".join(str(p.get("name", "?")) for p in t.get("participants") or [])
            print(f"{t.get('id', '?')}  status {t.get('status', '?')}  {t.get('unread', 0)} unread  | {names}")
        print(f"(wake API: {len(opened)} thread(s) opened by {alias}; read one with wake --thread <id>)")
    else:
        print(f"no threads opened by {a.source}{api_missing_hint(alias)}")
    sys.exit(0)
if a.reply:
    if len(a.reply) < 2:
        sys.exit('usage: wake --reply <thread-id> "YOUR ANSWER"')
    sys.exit(
        reply(
            a.reply[0],
            " ".join(a.reply[1:]),
            a.source,
            a.notify or a.source.startswith("bot:"),
            a.force,
            a.silent,
            a.notify,
            a.no_ring,
            a.chatty,
        )
    )

if a.ask:
    b = resolve(a.ask, bots) or sys.exit("unknown bot; see wake --list")
    if b["kind"] == "private" and not a.allow_private:
        sys.exit(f"{b['name']} is private; add --allow-private to override")
    words = ([a.target] if a.target else []) + a.message
    if not words:
        sys.exit('usage: wake --ask <bot> "<question>" [--wait 180]')
    sys.exit(ask(b, " ".join(words), a.wait, a.level, a.source, a.force, a.no_send, a.silent))

if a.setup:
    b = resolve(a.setup, bots) or sys.exit("unknown bot; see wake --list")
    if b["kind"] == "private" and not a.allow_private:
        sys.exit(f"{b['name']} is private; add --allow-private to override")
    ensure_key(b, a.rotate)
    host(f"{KEY_HELPER} enable-bot {q(b['id'])}")
    print("ready")
    sys.exit(0)

if not a.target:
    if not sys.stdin.isatty():
        p.print_help()
        sys.exit(2)
    pick = [b for b in bots if b["kind"] == "open"]
    for i, b in enumerate(pick, 1):
        print(f"{i:>2}. {b['name']}  ({b['alias']})")
    n = input("bot number or name: ").strip()
    if n.startswith("wake "):
        n = n[5:].strip()
    first, _, rest = n.partition(" ")
    rest = rest.strip().strip(chr(34)).strip(chr(39))
    key = first if rest else n
    b = pick[int(key) - 1] if key.isdigit() and 0 < int(key) <= len(pick) else resolve(key, bots)
    if not b:
        sys.exit("no match")
    msg = rest or input("message: ").strip()
    send(b, a.source, a.event, a.level, msg, a.ref, a.force)
    sys.exit(0)

# `wake <alias> <message...>`: plain one-way message; `wake <other> ...` falls through to the legacy form
b = resolve(a.target, bots)
if b and a.message:
    if b["kind"] == "private" and not a.allow_private:
        sys.exit(f"{b['name']} is private; add --allow-private to override")
    if a.silent:
        queue_silent(b, " ".join(a.message), a.source)
        sys.exit(0)
    send(b, a.source, a.event, a.level, " ".join(a.message), a.ref, a.force)
    sys.exit(0)
if not a.message:
    sys.exit(f"unknown bot '{a.target}'. Run wake --list")
# legacy: `wake <source> <event> [detail...]` reports to the default bot
lead = resolve(DEFAULT_BOT, bots) or sys.exit(f"default bot {DEFAULT_BOT!r} (WAKE_BOT) is not in the registry")
send(lead, a.target, a.message[0], a.level, " ".join(a.message[1:]), a.ref, a.force)
