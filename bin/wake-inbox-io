#!/usr/bin/env python3
# desc: host/guest bridge for the agent-session wake inbox. `wake-inbox-io register <hash> [json]` makes the inbox and its active marker; `wake-inbox-io read <inbox>` prints the file; `wake-inbox-io beat <hash> [json]` refreshes the marker. Uses the local path when $WAKE_STATE_DIR/inbox is writable (or WAKE_HOSTOPS is unset), otherwise the host over WAKE_HOSTOPS.
import os
import re
import shlex
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wake_config  # noqa: E402

CFG = wake_config.load()
BASE = os.path.normpath(CFG["WAKE_STATE_DIR"] + "/inbox")
ACTIVE = BASE + "/active"
HOSTOPS = CFG["WAKE_HOSTOPS"]
HASH_RE = re.compile(r"[0-9a-f]{6,32}")
q = shlex.quote


def valid_hash(key):
    """An inbox id: 6-32 lowercase hex characters, nothing else."""
    return HASH_RE.fullmatch(key) is not None


def valid_inbox(path):
    """An inbox file: exactly <BASE>/<hash>.jsonl, compared as a normalised path (the file may live on the host)."""
    if not path.startswith("/") or os.path.normpath(path) != path:
        return False
    d, name = os.path.split(path)
    return d == BASE and name.endswith(".jsonl") and valid_hash(name[: -len(".jsonl")])


def local_ok():
    return os.path.isdir(BASE) and os.access(BASE, os.W_OK)


def sh(cmd, data=None):
    if local_ok() or not HOSTOPS:
        return subprocess.run(["bash", "-c", cmd], input=data, capture_output=True, text=True)
    return subprocess.run([HOSTOPS, cmd], input=data, capture_output=True, text=True)


def checked(r):
    """Fail the bridge when the command it ran failed.

    The host gate refuses anything off its allow-list. That refusal used to be discarded:
    register printed an inbox path for a file nothing had created, so the session exported
    WAKE_INBOX pointing at nothing and every delivery to it vanished while the caller
    believed it had worked.
    """
    if r.returncode == 0:
        return r
    detail = (r.stderr or "").strip()
    sys.stderr.write(detail + "\n" if detail else f"the host command exited {r.returncode}\n")
    sys.exit(r.returncode if 0 < r.returncode < 256 else 1)


HELP = """\
usage: wake-inbox-io register <hash> [json] | read <inbox> | beat <hash> [json]

  The host/guest bridge for an agent session's inbox. <hash> is the id the session chose: 6 to
  32 lowercase hex characters. <inbox> must be $WAKE_STATE_DIR/inbox/<hash>.jsonl.

  register <hash> [json]   make the inbox and its active marker, print the inbox path
  read <inbox>             print the inbox
  beat <hash> [json]       refresh the active marker; the JSON is stored beside it

  Markers older than 24 hours are pruned when a session registers. Every write goes through the
  local path when $WAKE_STATE_DIR/inbox is writable, otherwise over WAKE_HOSTOPS.

  environment   WAKE_STATE_DIR, WAKE_HOSTOPS   (both read by bin/wake_config.py)

  exit 0 on success; 1 on usage or a hash that is not 6-32 lowercase hex characters. If the command
  it runs on the host fails, its stderr is printed and its status is returned; a refused register
  never prints an inbox path.
"""


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(HELP, end="")
        return 0
    if len(sys.argv) < 3:
        sys.exit("usage: wake-inbox-io register <hash> [json] | read <inbox> | beat <hash> [json]")
    op, key = sys.argv[1], sys.argv[2]
    meta = sys.argv[3] if len(sys.argv) > 3 else "{}"
    if op in ("register", "beat") and not valid_hash(key):
        sys.exit("bad inbox hash: expected 6-32 lowercase hex characters")
    if op == "register":
        box, marker, active = q(f"{BASE}/{key}.jsonl"), q(f"{ACTIVE}/{key}.json"), q(ACTIVE)
        checked(
            sh(
                f"mkdir -p {active} 2>/dev/null; find {active} -name '*.json' -mmin +1440 -delete 2>/dev/null; "
                f"touch {box} {marker}; chmod 660 {box} {marker} 2>/dev/null"
            )
        )
        checked(sh(f"cat > {marker}", meta))
        print(f"{BASE}/{key}.jsonl")
        return
    if op == "read":
        if not valid_inbox(key):
            sys.exit(f"bad inbox path: expected {BASE}/<hash>.jsonl")
        sys.stdout.write(sh(f"cat {q(key)} 2>/dev/null").stdout)
        return
    if op == "beat":
        checked(sh(f"cat > {q(f'{ACTIVE}/{key}.json')}", meta))
        return
    sys.exit("unknown op " + op)


main()
