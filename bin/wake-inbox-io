#!/usr/bin/env python3
# desc: host/guest bridge for the agent-session wake inbox. `wake-inbox-io register <hash> [json]` makes the inbox and its active marker; `wake-inbox-io read <inbox>` prints the file; `wake-inbox-io beat <hash> [json]` refreshes the marker. Uses the local path when $WAKE_STATE_DIR/inbox is writable (a read, when it is readable); a session that predates the store's group re-enters through `sg`; otherwise the host over WAKE_HOSTOPS.
import grp
import os
import pwd
import re
import shlex
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wake_config  # noqa: E402

CFG = wake_config.load()
BASE = os.path.normpath(CFG["WAKE_STATE_DIR"] + "/inbox")
ACTIVE = BASE + "/active"
HOSTOPS = CFG["WAKE_HOSTOPS"]
HASH_RE = re.compile(r"[0-9a-f]{6,32}")
q = shlex.quote


def valid_hash(key):
    """An inbox id: 6-32 lowercase hex characters, nothing else."""
    return HASH_RE.fullmatch(key) is not None


def valid_inbox(path):
    """An inbox file: exactly <BASE>/<hash>.jsonl, compared as a normalised path (the file may live on the host)."""
    if not path.startswith("/") or os.path.normpath(path) != path:
        return False
    d, name = os.path.split(path)
    return d == BASE and name.endswith(".jsonl") and valid_hash(name[: -len(".jsonl")])


def local_ok(write=True):
    """Can this process use the store directly?

    A write needs the directory writable; a read only needs to reach it, so a store that
    is readable but not writable still answers reads here instead of being called
    unreachable.
    """
    if not os.path.isdir(BASE):
        return False
    return os.access(BASE, os.W_OK if write else os.R_OK | os.X_OK)


def store_group():
    """The group that owns the store: BASE itself, or the directory that would hold it.

    The store is `root:<group>` mode 2770, so that group is the only way in for a process that is
    neither root nor the owner. A store that does not exist yet is judged by its parent, so the
    first register on a fresh host still finds the group it has to enter.
    """
    for path in (BASE, os.path.dirname(BASE)):
        try:
            return grp.getgrgid(os.stat(path).st_gid)
        except (KeyError, OSError):
            continue
    return None


def group_member(g):
    """True when /etc/group lists this user in the group's member list."""
    if g is None:
        return False
    try:
        return pwd.getpwuid(os.getuid()).pw_name in g.gr_mem
    except KeyError:
        return False


def joins_store_group(g):
    """True when /etc/group lists this user for the store's group but this process lacks it.

    Linux fixes a process's supplementary groups at exec time: a shell started before the group
    existed never sees it, and every child it starts inherits the same list, so the store stays
    unreachable for the life of that session even though a new login would work. `sg` re-reads the
    group database, so it can enter the group without a new login.
    """
    return g is not None and g.gr_gid not in os.getgroups() and group_member(g)


def unreachable(g, write):
    """Exit 1 saying why, once per uid.

    The caller polls every few seconds and inherits this stderr, so one line per poll floods the
    session's terminal. The first line is the one that tells the operator what to do.
    """
    if g is None:
        hint = "the store has no group that can be joined"
    elif g.gr_gid in os.getgroups():
        # A new login would not change anything: this session already has the group
        hint = f"this account is in group {g.gr_name}, so check the store's mode"
    elif g.gr_gid == 0:
        # root:root is the ownership mistake these routes exist to catch (the store must belong to
        # a group the bots are in). No one is added to root, so a join cannot be the fix (#135 F4).
        hint = "the store belongs to group root: chgrp it to a group this account is in, then log in again"
    else:
        hint = f"add this account to group {g.gr_name}, then log in again"
    need = "writable" if write else "readable"
    text = (
        f"wake-inbox-io: {BASE} is not {need} by uid {os.getuid()} and WAKE_HOSTOPS is empty; "
        f"{hint} (nothing was read or written)"
    )
    marker = os.path.join(tempfile.gettempdir(), f".wake-inbox-io-warned-{os.getuid()}")
    try:
        fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        sys.exit(1)
    except OSError:
        sys.stderr.write(text + "\n")
        sys.exit(1)
    with os.fdopen(fd, "w") as f:
        f.write(BASE + "\n")
    sys.stderr.write(text + "\n")
    sys.exit(1)


def clear_unreachable_marker():
    """Re-arm the once-per-uid line: a route exists again, so the next outage must be reported.

    The marker is written by unreachable() and was never removed, so the first outage in the life
    of an account was the only one ever reported: every later one, and any other store, exited 1
    with an empty stderr (#135 F2). It is cleared on the route rather than compared in the marker
    because the question is not which store failed, it is whether this account reaches the store.
    """
    try:
        os.unlink(os.path.join(tempfile.gettempdir(), f".wake-inbox-io-warned-{os.getuid()}"))
    except OSError:
        pass


def sh(cmd, data=None, write=True):
    """Run one command where the store can be reached: here, through sg, or on the host.

    A reachable inbox is best: writable for a write, readable for a read. Then `sg`, which lets a
    session older than the store's group in without a new login. Then WAKE_HOSTOPS, the guest's
    route. When the store exists and none of those can reach it, say so once instead of running a
    command that can only fail on every poll; when it does not exist yet, a local run creates it,
    which is how a first register works on a host with no bridge to anyone else.
    """
    if local_ok(write):
        clear_unreachable_marker()
        return subprocess.run(["bash", "-c", cmd], input=data, capture_output=True, text=True)
    g = store_group()
    if joins_store_group(g):
        clear_unreachable_marker()
        return subprocess.run(["sg", g.gr_name, "-c", cmd], input=data, capture_output=True, text=True)
    if HOSTOPS:
        clear_unreachable_marker()
        return subprocess.run([HOSTOPS, cmd], input=data, capture_output=True, text=True)
    if os.path.isdir(BASE):
        unreachable(g, write)
    return subprocess.run(["bash", "-c", cmd], input=data, capture_output=True, text=True)


def checked(r):
    """Fail the bridge when the command it ran failed.

    The host gate refuses anything off its allow-list. That refusal used to be discarded:
    register printed an inbox path for a file nothing had created, so the session exported
    WAKE_INBOX pointing at nothing and every delivery to it vanished while the caller
    believed it had worked.
    """
    if r.returncode == 0:
        return r
    detail = (r.stderr or "").strip()
    sys.stderr.write(detail + "\n" if detail else f"the host command exited {r.returncode}\n")
    sys.exit(r.returncode if 0 < r.returncode < 256 else 1)


HELP = """\
usage: wake-inbox-io register <hash> [json] | read <inbox> | beat <hash> [json]

  The host/guest bridge for an agent session's inbox. <hash> is the id the session chose: 6 to
  32 lowercase hex characters. <inbox> must be $WAKE_STATE_DIR/inbox/<hash>.jsonl.

  register <hash> [json]   make the inbox and its active marker, print the inbox path
  read <inbox>             print the inbox
  beat <hash> [json]       refresh the active marker; the JSON is stored beside it

  Markers older than 24 hours are pruned when a session registers. A write runs locally when
  $WAKE_STATE_DIR/inbox is writable, and a read when it is readable. When it is neither, but
  /etc/group lists this account for the store's group, it re-enters through `sg <group>`: a shell
  started before the group existed keeps its old supplementary list, and `sg` re-reads the group
  database without a new login. Otherwise it goes over WAKE_HOSTOPS.

  environment   WAKE_STATE_DIR, WAKE_HOSTOPS   (both read by bin/wake_config.py)

  exit 0 on success; 1 on usage or a hash that is not 6-32 lowercase hex characters, or when the
  store is unreachable and WAKE_HOSTOPS is empty (that line is printed once per uid per outage,
  and again after a command reaches the store). If the command it runs fails, its stderr is
  printed and its status is returned; a refused register never prints an inbox path.
"""


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(HELP, end="")
        return 0
    if len(sys.argv) < 3:
        sys.exit("usage: wake-inbox-io register <hash> [json] | read <inbox> | beat <hash> [json]")
    op, key = sys.argv[1], sys.argv[2]
    meta = sys.argv[3] if len(sys.argv) > 3 else "{}"
    if op in ("register", "beat") and not valid_hash(key):
        sys.exit("bad inbox hash: expected 6-32 lowercase hex characters")
    if op == "register":
        box, marker, active = q(f"{BASE}/{key}.jsonl"), q(f"{ACTIVE}/{key}.json"), q(ACTIVE)
        checked(
            sh(
                f"mkdir -p {active} 2>/dev/null; find {active} -name '*.json' -mmin +1440 -delete 2>/dev/null; "
                f"touch {box} {marker}; chmod 660 {box} {marker} 2>/dev/null"
            )
        )
        checked(sh(f"cat > {marker}", meta))
        print(f"{BASE}/{key}.jsonl")
        return
    if op == "read":
        if not valid_inbox(key):
            sys.exit(f"bad inbox path: expected {BASE}/<hash>.jsonl")
        sys.stdout.write(sh(f"cat {q(key)} 2>/dev/null", write=False).stdout)
        return
    if op == "beat":
        checked(sh(f"cat > {q(f'{ACTIVE}/{key}.json')}", meta))
        return
    sys.exit("unknown op " + op)


if __name__ == "__main__":
    main()
