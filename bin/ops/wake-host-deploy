#!/usr/bin/env python3
# desc: deploy the wake API to a host as a native systemd service: db|user|build|install|env|unit|status|log. Idempotent, one step at a time, never prints a secret. Usage: wake-host-deploy [STEP ...] [--dry-run]
"""Put apps/api on a host as a native systemd service, one attributable step at a time.

Host access is one of two shapes, both from the environment:

  WAKE_HOSTOPS=<runner>   an executable that runs its single argument as a shell
                          command on the host (the same convention bin/wake uses)
  WAKE_HOST_SSH=<dest>    an ssh destination; host files are copied with scp

Every step is idempotent, so a failed run is re-run, not repaired by hand. Secrets
come from the environment (WAKE_DB_PASSWORD, WAKE_REGISTRATION_SECRET) and are
written through stdin: they are never printed and never appear on a command line,
which is also why the environment file's contents are not echoed under --dry-run.
"""

import base64
import io
import os
import re
import shlex
import subprocess
import sys
import tarfile
import tempfile

USAGE = """usage: wake-host-deploy [STEP ...] [--dry-run]

Steps, in the order a first install needs them:
  db       create or update the database role and the database itself
  user     create the unprivileged service account
  build    build apps/api into one file with the local builder
  install  put the build, the migrations and a node binary under the install dir
  env      write the environment file (needs WAKE_DB_PASSWORD, WAKE_REGISTRATION_SECRET)
  unit     install and start the systemd unit
  status   is it enabled, active, and answering on its port
  log      the last lines of its journal

With no step it runs `status`. --dry-run prints each host command and writes nothing.

install takes the build this operator made: build records it under WAKE_DEPLOY_STATE
and install reads only that, so a stale or planted directory in /tmp is never installed.
Migrations arrive as one tar stream (exact names, no /tmp staging) and a .sql file the
checkout no longer has is removed, because migrations key on filename.
env merges: lines the operator added stay, the five keys below are (re)written, and
WAKE_MCP_ENABLED comes from this environment - default false, so a deploy does not
republish a /mcp endpoint that was halted on purpose.

Env: WAKE_HOSTOPS or WAKE_HOST_SSH (one is required), WAKE_SUDO (`sudo -n`),
WAKE_REPO (checkout), WAKE_SERVICE (wake-api), WAKE_SERVICE_USER / WAKE_SERVICE_GROUP
(wake), WAKE_INSTALL_DIR (/opt/wake), WAKE_ENV_FILE (/etc/wake/api.env),
WAKE_UNIT_DIR (/etc/systemd/system), WAKE_DB_NAME / WAKE_DB_ROLE (wake),
WAKE_DB_HOST (127.0.0.1), WAKE_DB_PORT (5432), WAKE_PORT (3001), WAKE_BIND
(127.0.0.1), WAKE_BUILDER (bun), WAKE_NODE (the host's node binary; default: look it
up with `command -v node`), WAKE_DEPLOY_STATE (~/.cache/wake/deploy: where build
records its artifact), WAKE_MCP_ENABLED (false), WAKE_DB_PASSWORD,
WAKE_REGISTRATION_SECRET.

exit: 0 the steps ran, 1 a step failed, 2 bad input
"""

SUDO = os.environ.get("WAKE_SUDO", "sudo -n")
SERVICE = os.environ.get("WAKE_SERVICE", "wake-api")
SERVICE_USER = os.environ.get("WAKE_SERVICE_USER", "wake")
SERVICE_GROUP = os.environ.get("WAKE_SERVICE_GROUP", "wake")
INSTALL_DIR = os.environ.get("WAKE_INSTALL_DIR", "/opt/wake")
ENV_FILE = os.environ.get("WAKE_ENV_FILE", "/etc/wake/api.env")
UNIT_DIR = os.environ.get("WAKE_UNIT_DIR", "/etc/systemd/system")
DB_NAME = os.environ.get("WAKE_DB_NAME", "wake")
DB_ROLE = os.environ.get("WAKE_DB_ROLE", "wake")
DB_HOST = os.environ.get("WAKE_DB_HOST", "127.0.0.1")
DB_PORT = os.environ.get("WAKE_DB_PORT", "5432")
PORT = os.environ.get("WAKE_PORT", "3001")
BIND = os.environ.get("WAKE_BIND", "127.0.0.1")
BUILDER = os.environ.get("WAKE_BUILDER", "bun")
PSQL = f"{SUDO} -u postgres psql" if SUDO else "psql -U postgres"
# Where build records the artifact it made, so install takes that one and not whatever a
# temp-directory glob finds. Private to the operator: 0700 directory, 0600 pointer.
STATE_DIR = os.environ.get("WAKE_DEPLOY_STATE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "wake", "deploy"
)
DRY = False

UNIT = """[Unit]
Description={service} (agents, messages, threads, doorbell, MCP)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User={user}
Group={group}
WorkingDirectory={dir}
EnvironmentFile={env_file}
ExecStart={node} {dir}/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
"""


def usage():
    print(USAGE, end="")


def priv(command):
    return f"{SUDO} {command}" if SUDO else command


def transport(command):
    hostops = os.environ.get("WAKE_HOSTOPS")
    if hostops:
        return [hostops, command]
    dest = os.environ.get("WAKE_HOST_SSH")
    if dest:
        return ["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new", dest, command]
    return None


def host(command, data=None, check=True):
    argv = transport(command)
    if argv is None:
        sys.exit("wake-host-deploy: set WAKE_HOSTOPS (a runner for one shell command) or WAKE_HOST_SSH (a destination)")
    if DRY:
        print(f"  $ {command}")
        return ""
    r = subprocess.run(argv, input=data if data is not None else "", capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if check and r.returncode != 0:
        sys.exit(f"FAILED: {command[:70]}\n{out[-800:]}")
    return out


def put(local, remote):
    dest = os.environ.get("WAKE_HOST_SSH")
    if DRY:
        print(f"  $ put {local} -> {remote}")
        return
    if dest:
        r = subprocess.run(
            ["scp", "-q", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new", local, f"{dest}:{remote}"],
            capture_output=True,
            text=True,
        )
        if r.returncode != 0:
            sys.exit(f"scp failed: {r.stderr[-400:]}")
        return
    with open(local, encoding="utf-8") as f:
        host(f"cat > {shlex.quote(remote)}", data=f.read())


def sql_name(variable, value):
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", value):
        sys.exit(f"wake-host-deploy: {variable} must be a plain identifier, not {value!r}")
    return value


def db_password():
    """The one rule for the password: env builds a URL from it, db quotes it into SQL."""
    password = os.environ.get("WAKE_DB_PASSWORD")
    if not password:
        sys.exit("wake-host-deploy: WAKE_DB_PASSWORD is not in the environment")
    if not password.isalnum():
        sys.exit("wake-host-deploy: WAKE_DB_PASSWORD has non-alphanumerics, which the quoting path does not cover")
    return password


def step_db():
    password = db_password()
    role = sql_name("WAKE_DB_ROLE", DB_ROLE)
    name = sql_name("WAKE_DB_NAME", DB_NAME)
    body = (
        "DO $do$ BEGIN\n"
        f"  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{role}')\n"
        f"    THEN ALTER ROLE {role} LOGIN PASSWORD '{password}';\n"
        f"    ELSE CREATE ROLE {role} LOGIN PASSWORD '{password}';\n"
        "  END IF;\n"
        "END $do$;\n"
    )
    print("role:", host(f"{PSQL} -v ON_ERROR_STOP=1 -q -f -", data=body) or "ok")
    present = host(f"""{PSQL} -tAc "select 1 from pg_database where datname = '{name}'" """.strip())
    if present.strip() != "1":
        print("db:", host(f"{priv('createdb')} -O {role} {name}"))
    else:
        print("db: already present")
    owner = host(f"""{PSQL} -tAc "select pg_get_userbyid(datdba) from pg_database where datname='{name}'" """.strip())
    print("owner:", owner)


def step_user():
    # The group comes first: `useradd --gid wake` fails with "group 'wake' does not exist" on a
    # clean host, and deploy/README.md's order (db, user, install, env, unit) then stops at step two.
    print(
        "group:",
        host(f"getent group {SERVICE_GROUP} >/dev/null || {priv('groupadd')} --system {SERVICE_GROUP}"),
    )
    found = host("getent passwd " + SERVICE_USER + " || true")
    if found.strip():
        print("user: exists ->", found.strip())
        return
    print(
        "user:",
        host(
            f"{priv('useradd')} --system --gid {SERVICE_GROUP} --home-dir {INSTALL_DIR} "
            f"--no-create-home --shell /usr/sbin/nologin {SERVICE_USER} && getent passwd {SERVICE_USER}"
        ),
    )


def step_build():
    root = os.environ.get("WAKE_REPO") or os.getcwd()
    entry = os.path.join(root, "apps/api/src/index.ts")
    if not os.path.isfile(entry):
        sys.exit(f"wake-host-deploy: no {entry}: set WAKE_REPO to the checkout")
    out = tempfile.mkdtemp(prefix="wake-build-")
    if DRY:
        print(f"  $ {BUILDER} build {entry} --target=node --outfile={out}/index.mjs")
        print(f"  $ record {out} in {STATE_DIR}/last-build")
        return
    r = subprocess.run(
        [BUILDER, "build", entry, "--target=node", f"--outfile={out}/index.mjs"],
        cwd=root,
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        sys.exit(f"build failed: {r.stderr[-600:]}")
    record_build(out)
    migrations = os.path.join(root, "apps/api/src/migrations")
    print("migrations:", len(os.listdir(migrations)) if os.path.isdir(migrations) else 0)
    print("size:", os.path.getsize(f"{out}/index.mjs"))


def require_private(path, consequence):
    """A directory is private when it is ours and nobody else can look in or write in it."""
    info = os.stat(path)
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        sys.exit(f"wake-host-deploy: {path} is not a private directory of yours: {consequence}")


def state_dir():
    """The deploy state directory: 0700, created here, and never a directory we did not make.

    record_build used to chmod whatever STATE_DIR named, so WAKE_DEPLOY_STATE=/tmp or any
    shared directory this operator owns but did not make came back 0700, and a directory
    someone else owns had a chmod aimed at it. The chmod now runs only on a directory this
    call created; one that already exists must already be private, and is refused rather
    than repaired.
    """
    try:
        os.makedirs(STATE_DIR, mode=0o700)
    except FileExistsError:
        if not os.path.isdir(STATE_DIR):
            sys.exit(f"wake-host-deploy: {STATE_DIR} is not a directory")
        require_private(STATE_DIR, "let this tool create it, or chmod 700 it")
        return
    os.chmod(STATE_DIR, 0o700)


def record_build(path):
    """Remember this build, so install cannot pick up someone else's."""
    state_dir()
    pointer = os.path.join(STATE_DIR, "last-build")
    tmp = pointer + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(path + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, pointer)


def build_dir():
    """The build this operator made, or a stop. Never a glob of the temp directory.

    Under --dry-run nothing is installed, so a record that a real run would refuse is named
    and the plan still prints: the dry run used to exit 1 before showing a single command.
    """
    pointer = os.path.join(STATE_DIR, "last-build")
    try:
        with open(pointer, encoding="utf-8") as f:
            made = f.read().strip()
    except OSError:
        if DRY:
            return None
        sys.exit("wake-host-deploy: no build recorded: run the build step first")
    problem = None
    if not made:
        problem = "no build recorded: run the build step first"
    elif not os.path.isdir(made):
        problem = f"the recorded build {made} is gone: run the build step again"
    else:
        info = os.stat(made)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            problem = f"{made} is not a private directory of yours: run the build step again"
        elif not os.path.isfile(os.path.join(made, "index.mjs")):
            problem = f"{made} has no index.mjs: run the build step again"
    if problem is None:
        return made
    if DRY:
        print(f"wake-host-deploy: note: a real run stops here: {problem}", file=sys.stderr)
        return made or None
    sys.exit(f"wake-host-deploy: {problem}")


MIGRATION = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]*\.sql\Z")


def migration_payload(directory):
    """One tar stream of the migrations, as base64 text, so no file is staged in /tmp."""
    names = sorted(n for n in os.listdir(directory) if n.endswith(".sql")) if os.path.isdir(directory) else []
    for name in names:
        if not MIGRATION.match(name):
            sys.exit(f"wake-host-deploy: {name} is not a migration name (letters, digits, dot, dash, underscore)")
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tar:
        for name in names:
            tar.add(os.path.join(directory, name), arcname=name)
    return names, base64.b64encode(buf.getvalue()).decode("ascii")


def step_install():
    out = build_dir()
    root = os.environ.get("WAKE_REPO") or os.getcwd()
    node = os.environ.get("WAKE_NODE") or host("command -v node").strip()
    if not node:
        if DRY:
            print("  $ node: the host's `command -v node`")
            node = "<node>"
        else:
            sys.exit("wake-host-deploy: no node on the host: set WAKE_NODE")
    host(f"{priv('install')} -d -o root -g {SERVICE_GROUP} -m 755 {INSTALL_DIR} {INSTALL_DIR}/migrations")
    host(f"{priv('install')} -m 755 {shlex.quote(node)} {INSTALL_DIR}/node")
    if out is None:
        print(f"  $ put <build>/index.mjs -> {INSTALL_DIR}.index.mjs")
    else:
        put(os.path.join(out, "index.mjs"), f"{INSTALL_DIR}.index.mjs")
    host(
        f"{priv('install')} -o root -g {SERVICE_GROUP} -m 644 {INSTALL_DIR}.index.mjs {INSTALL_DIR}/index.mjs "
        f"&& rm -f {INSTALL_DIR}.index.mjs"
    )
    migrations = os.path.join(root, "apps/api/src/migrations")
    names, payload = migration_payload(migrations)
    if names:
        # One stream in, exact names out: a /tmp glob used to install whatever happened to match it.
        host(f"base64 -d | {priv('tar')} -x --no-same-owner -C {INSTALL_DIR}/migrations", data=payload)
        # A migration the checkout no longer has must not come back at the next boot.
        keep = " ".join(names)
        host(
            f'cd {INSTALL_DIR}/migrations && for f in *.sql; do [ -e "$f" ] || continue; '
            f'case " {keep} " in *" $f "*) ;; *) {priv("rm")} -f "$f" ;; esac; done'
        )
    host(
        f"{priv('chown')} -R root:{SERVICE_GROUP} {INSTALL_DIR}/migrations && "
        f"{priv('chmod')} 644 {INSTALL_DIR}/migrations/*.sql"
    )
    print(host(f"ls -l {INSTALL_DIR} {INSTALL_DIR}/migrations | head -8"))


def merge_env(existing, values):
    """Keep every line the operator added; set the keys we own; no duplicates.

    Every value is checked here, where the lines are written, so a key nobody names is covered
    too: WAKE_MCP_ENABLED used to accept "true\\\\nINJECTED_EVIL=1" and add that line to the file.
    """
    managed = dict(values)
    for key, value in managed.items():
        no_control(key, value)
    lines = []
    seen = set()
    for line in existing.splitlines():
        key, sep, _ = line.partition("=")
        key = key.strip()
        if sep and key in managed and not line.lstrip().startswith("#"):
            if key in seen:
                continue
            lines.append(f"{key}={managed[key]}")
            seen.add(key)
            continue
        lines.append(line)
    for key, value in managed.items():
        if key not in seen:
            lines.append(f"{key}={value}")
    return "\n".join(line for line in lines if line.strip() != "") + "\n"


def no_control(name, value):
    """An environment file is lines: a value with a newline would add one of its own."""
    bad = next((c for c in value if ord(c) < 0x20 or ord(c) == 0x7F), None)
    if bad is not None:
        sys.exit(f"wake-host-deploy: {name} has a control character ({bad!r}), which would break the environment file")


def step_env():
    password = db_password()
    secret = os.environ.get("WAKE_REGISTRATION_SECRET")
    if not secret:
        sys.exit("wake-host-deploy: WAKE_REGISTRATION_SECRET is not in the environment")
    no_control("WAKE_REGISTRATION_SECRET", secret)
    # The API refuses to boot with a shorter value (apps/api/src/options.ts), so writing one
    # would leave a file that cannot start. Refuse before the host is touched.
    if len(secret) < 32:
        sys.exit(
            "wake-host-deploy: WAKE_REGISTRATION_SECRET must be at least 32 characters, or the API will refuse to start"
        )
    values = {
        "DATABASE_URL": f"postgres://{DB_ROLE}:{password}@{DB_HOST}:{DB_PORT}/{DB_NAME}",
        "HOST": BIND,
        "PORT": PORT,
        "REGISTRATION_SECRET": secret,
        # Off unless the operator says so: re-imposing "true" silently republishes an endpoint
        # that was halted on purpose.
        "WAKE_MCP_ENABLED": os.environ.get("WAKE_MCP_ENABLED", "false"),
    }
    # merge_env refuses these too; checked here so a refusal costs no host command at all.
    for key, value in values.items():
        no_control(key, value)
    existing = ""
    if not DRY:
        existing = host(f"{priv('cat')} {ENV_FILE} 2>/dev/null || true")
    body = merge_env(existing, values)
    directory = os.path.dirname(ENV_FILE)
    host(f"{priv('install')} -d -o root -g {SERVICE_GROUP} -m 750 {directory}")
    # Write beside the live file and rename over it: a write that fails or is interrupted then
    # leaves the service its working environment file instead of an empty one. A rename
    # replaces a symlinked api.env instead of writing through it, which is the safe direction.
    staged = ENV_FILE + ".new"
    host(f"{priv('install')} -o root -g {SERVICE_GROUP} -m 640 /dev/null {staged}")
    host(f"{priv('tee')} {staged} >/dev/null", data=body)
    host(f"{priv('mv')} -f {staged} {ENV_FILE}")
    print(host(f"{priv('ls')} -l {ENV_FILE}"))


def step_unit():
    body = UNIT.format(
        service=SERVICE,
        user=SERVICE_USER,
        group=SERVICE_GROUP,
        dir=INSTALL_DIR,
        env_file=ENV_FILE,
        node=f"{INSTALL_DIR}/node",
    )
    host(f"{priv('tee')} {UNIT_DIR}/{SERVICE}.service >/dev/null", data=body)
    print(host(f"{priv('systemctl')} daemon-reload && {priv('systemctl')} enable --now {SERVICE}.service"))


def step_status():
    print(host(f"systemctl is-enabled {SERVICE}.service; systemctl is-active {SERVICE}.service"))
    print(host(f"{priv('systemctl')} status {SERVICE}.service --no-pager -l | head -12"))
    print(host(f"curl -fsS http://127.0.0.1:{PORT}/health; echo"))


def step_log():
    print(host(f"{priv('journalctl')} -u {SERVICE}.service -n 40 --no-pager | tail -40"))


STEPS = {
    "db": step_db,
    "user": step_user,
    "build": step_build,
    "install": step_install,
    "env": step_env,
    "unit": step_unit,
    "status": step_status,
    "log": step_log,
}


def main(argv):
    global DRY
    steps = []
    for arg in argv:
        if arg in ("-h", "--help", "help"):
            usage()
            return 0
        if arg == "--dry-run":
            DRY = True
            continue
        if arg not in STEPS:
            print(f"wake-host-deploy: unknown step: {arg}", file=sys.stderr)
            usage()
            return 2
        steps.append(arg)
    if transport("") is None:
        print("wake-host-deploy: set WAKE_HOSTOPS or WAKE_HOST_SSH", file=sys.stderr)
        return 2
    for name in steps or ["status"]:
        print(f"--- {name}")
        STEPS[name]()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
