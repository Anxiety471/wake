#!/usr/bin/env python3
# desc: deploy the wake API to a host as a native systemd service: db|user|build|install|env|unit|status|log. Idempotent, one step at a time, never prints a secret. Usage: wake-host-deploy [STEP ...] [--dry-run]
"""Put apps/api on a host as a native systemd service, one attributable step at a time.

Host access is one of two shapes, both from the environment:

  WAKE_HOSTOPS=<runner>   an executable that runs its single argument as a shell
                          command on the host (the same convention bin/wake uses)
  WAKE_HOST_SSH=<dest>    an ssh destination; host files are copied with scp

Every step is idempotent, so a failed run is re-run, not repaired by hand. Secrets
come from the environment (WAKE_DB_PASSWORD, WAKE_REGISTRATION_SECRET) and are
written through stdin: they are never printed and never appear on a command line,
which is also why the environment file's contents are not echoed under --dry-run.
"""

import base64
import io
import os
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile

USAGE = """usage: wake-host-deploy [STEP ...] [--dry-run]

Steps, in the order a first install needs them:
  db       create or update the database role and the database itself
  user     create the unprivileged service account
  build    build apps/api into one file with the local builder
  install  put the build, the migrations and a node binary under the install dir
  env      write the environment file (needs WAKE_DB_PASSWORD, WAKE_REGISTRATION_SECRET)
  unit     install and start the systemd unit
  status   is it enabled, active, and answering on its port
  log      the last lines of its journal

With no step it runs `status`. --dry-run prints each host command and writes nothing.

build refuses a tree it cannot name afterwards: a checkout with uncommitted changes (it
lists the files) or a HEAD that is not origin/main's commit (it names both ids). The build
is stamped with the commit it came from, and read again after the builder returns: a tree
that moved mid-build is not recorded. WAKE_ALLOW_ANY_REF=1 (also true, yes, on) is the
deliberate hotfix: it builds the checked-out commit and says so on stderr.

install takes the build this operator made: build records it under WAKE_DEPLOY_STATE
and install reads only that, so a stale or planted directory in /tmp is never installed.
The build carries a copy of the migrations it was made with, so install never reads the
checkout: a .sql added after the build used to run against the live database while the
same run printed the build's commit. Migrations arrive as one tar stream (exact names, no
/tmp staging) and a .sql the build does not carry is removed, because migrations key on
filename. status prints the commit install wrote beside the installed file, which is what
the service is running, not the last thing this checkout built.
env merges: lines the operator added stay, the five keys below are (re)written, and
WAKE_MCP_ENABLED comes from this environment - default false, so a deploy does not
republish a /mcp endpoint that was halted on purpose.

Env: WAKE_HOSTOPS or WAKE_HOST_SSH (one is required; WAKE_HOSTOPS wins when both
are set, and the bytes then travel through the runner, never scp), WAKE_SUDO (`sudo -n`),
WAKE_REPO (checkout), WAKE_SERVICE (wake-api), WAKE_SERVICE_USER / WAKE_SERVICE_GROUP
(wake), WAKE_INSTALL_DIR (/opt/wake), WAKE_ENV_FILE (/etc/wake/api.env),
WAKE_UNIT_DIR (/etc/systemd/system), WAKE_DB_NAME / WAKE_DB_ROLE (wake),
WAKE_DB_HOST (127.0.0.1), WAKE_DB_PORT (5432), WAKE_PORT (3001), WAKE_BIND
(127.0.0.1), WAKE_BUILDER (bun), WAKE_ALLOW_ANY_REF (off: 1, true, yes or on builds any
checked-out commit), WAKE_NODE (the host's node binary; default: look it
up with `command -v node`), WAKE_DEPLOY_STATE (~/.cache/wake/deploy: where build
records its artifact), WAKE_MCP_ENABLED (false), WAKE_DB_PASSWORD,
WAKE_REGISTRATION_SECRET.

exit: 0 the steps ran, 1 a step failed, 2 bad input
"""

SUDO = os.environ.get("WAKE_SUDO", "sudo -n")
SERVICE = os.environ.get("WAKE_SERVICE", "wake-api")
SERVICE_USER = os.environ.get("WAKE_SERVICE_USER", "wake")
SERVICE_GROUP = os.environ.get("WAKE_SERVICE_GROUP", "wake")
INSTALL_DIR = os.environ.get("WAKE_INSTALL_DIR", "/opt/wake")
ENV_FILE = os.environ.get("WAKE_ENV_FILE", "/etc/wake/api.env")
UNIT_DIR = os.environ.get("WAKE_UNIT_DIR", "/etc/systemd/system")
DB_NAME = os.environ.get("WAKE_DB_NAME", "wake")
DB_ROLE = os.environ.get("WAKE_DB_ROLE", "wake")
DB_HOST = os.environ.get("WAKE_DB_HOST", "127.0.0.1")
DB_PORT = os.environ.get("WAKE_DB_PORT", "5432")
PORT = os.environ.get("WAKE_PORT", "3001")
BIND = os.environ.get("WAKE_BIND", "127.0.0.1")
BUILDER = os.environ.get("WAKE_BUILDER", "bun")
PSQL = f"{SUDO} -u postgres psql" if SUDO else "psql -U postgres"
# Where build records the artifact it made, so install takes that one and not whatever a
# temp-directory glob finds. Private to the operator: 0700 directory, 0600 pointer.
STATE_DIR = os.environ.get("WAKE_DEPLOY_STATE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "wake", "deploy"
)
DRY = False
# A deliberate hotfix may build a commit that is not origin/main. Off by default: the one
# question a deploy has to answer afterwards is which tree it shipped.
ALLOW_ANY_REF = os.environ.get("WAKE_ALLOW_ANY_REF", "").strip().lower() in ("1", "true", "yes", "on")

UNIT = """[Unit]
Description={service} (agents, messages, threads, doorbell, MCP)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User={user}
Group={group}
WorkingDirectory={dir}
EnvironmentFile={env_file}
ExecStart={node} {dir}/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
"""


def usage():
    print(USAGE, end="")


def priv(command):
    return f"{SUDO} {command}" if SUDO else command


def transport_kind():
    """Which transport is in use: WAKE_HOSTOPS, else WAKE_HOST_SSH, else none.

    host() and put() both ask this one question, so they cannot disagree about where a command
    goes and where a file goes: with both variables set, put() used to stage over scp while every
    command around it ran through the runner (#117).
    """
    if os.environ.get("WAKE_HOSTOPS"):
        return "hostops"
    if os.environ.get("WAKE_HOST_SSH"):
        return "ssh"
    return None


def transport(command):
    kind = transport_kind()
    if kind == "hostops":
        return [os.environ["WAKE_HOSTOPS"], command]
    if kind == "ssh":
        return [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "StrictHostKeyChecking=accept-new",
            os.environ["WAKE_HOST_SSH"],
            command,
        ]
    return None


def _run(command, data, check, streams):
    argv = transport(command)
    if argv is None:
        sys.exit("wake-host-deploy: set WAKE_HOSTOPS (a runner for one shell command) or WAKE_HOST_SSH (a destination)")
    if DRY:
        print(f"  $ {command}")
        return ""
    r = subprocess.run(argv, input=data if data is not None else "", capture_output=True, text=True)
    if check and r.returncode != 0:
        sys.exit(f"FAILED: {command[:70]}\n{(r.stdout + r.stderr).strip()[-800:]}")
    return (r.stdout + r.stderr).strip() if streams == "both" else r.stdout.strip()


def host(command, data=None, check=True):
    """Run a command whose output a human reads: stdout and stderr together, as one block."""
    return _run(command, data, check, "both")


def host_out(command, data=None, check=True):
    """Run a command for a value: stdout only.

    stderr is the host's own chatter (a host-key notice, a warning from a wrapper around the
    runner) and must never become part of an answer. Spliced into a value it has named a file
    that does not exist, reported an account that was never created, and written a warning into
    api.env (#117).
    """
    return _run(command, data, check, "stdout")


def put(local, remote):
    """Write `local` to `remote` as root, over whichever transport is configured.

    Every caller stages into the install dir's parent, which is root-owned, and the documented
    operator is a non-root account with `sudo -n` (#109): an unprivileged `cat > /opt/wake.index.mjs`
    is a permission error, so the file is created through install(1) and filled through priv().
    The ssh transport lands the bytes in the operator's own /tmp first and install(1) moves them,
    because scp has no way to write through sudo.
    """
    if DRY:
        print(f"  $ put {local} -> {remote}")
        return
    quoted = shlex.quote(remote)
    if transport_kind() == "ssh":
        dest = os.environ["WAKE_HOST_SSH"]
        # host_out, not host: the name mktemp prints is stdout, and stderr is the host's own
        # chatter. A host-key notice spliced into the name made scp write a file by that name and
        # install then fail with "No such file or directory" (#117).
        answer = host_out("mktemp /tmp/.wake-deploy.XXXXXX").splitlines()
        if not answer:
            sys.exit("wake-host-deploy: the host did not name a staging file")
        staged = answer[0]
        try:
            r = subprocess.run(
                [
                    "scp",
                    "-q",
                    "-o",
                    "BatchMode=yes",
                    "-o",
                    "StrictHostKeyChecking=accept-new",
                    local,
                    f"{dest}:{staged}",
                ],
                capture_output=True,
                text=True,
            )
            if r.returncode != 0:
                # scp truncates the staged file before the transfer ends, so a dropped connection
                # leaves half a bundle behind: the failure is collected like a refused install (#129).
                sys.exit(f"scp failed: {r.stderr[-400:]}")
            host(
                f"{priv('install')} -o root -g {SERVICE_GROUP} -m 644 {shlex.quote(staged)} {quoted} && "
                f"{priv('rm')} -f {shlex.quote(staged)}"
            )
        except (SystemExit, OSError) as e:
            # Nothing may strand the operator's copy of the bundle in the host's /tmp: the install
            # and its cleanup were one `&&` chain, so a refused install never ran the rm (#117), and
            # a failed scp used to exit before this try existed (#129). OSError is the local scp that
            # is not installed at all: subprocess.run raises FileNotFoundError, which is not a
            # SystemExit, so the staged file was left behind (#134). The file is collected here and
            # the failure is one line: a traceback is not a diagnosis, and the changelog said so.
            # The cleanup is checked, not assumed: the message claimed the file was removed after a
            # run with check=False, so a host that refused the rm was reported as a clean one (#146).
            try:
                host(f"{priv('rm')} -f {shlex.quote(staged)}")
            except SystemExit as cleanup:
                removed, because = False, str(cleanup.code or cleanup)[:200]
            else:
                removed, because = True, ""
            if isinstance(e, OSError):
                tail = "the staged file was removed from the host"
                if not removed:
                    tail = f"the staged file may still be on the host: {because}"
                sys.exit(f"wake-host-deploy: could not run scp ({e.strerror or e}); {tail}")
            if not removed:
                sys.stderr.write(f"wake-host-deploy: the staged file may still be on the host: {because}\n")
            raise
        return
    host(f"{priv('install')} -o root -g {SERVICE_GROUP} -m 644 /dev/null {quoted}")
    with open(local, encoding="utf-8") as f:
        host(f"{priv('tee')} {quoted} >/dev/null", data=f.read())


def sql_name(variable, value):
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", value):
        sys.exit(f"wake-host-deploy: {variable} must be a plain identifier, not {value!r}")
    return value


def db_password():
    """The one rule for the password: env builds a URL from it, db quotes it into SQL."""
    password = os.environ.get("WAKE_DB_PASSWORD")
    if not password:
        sys.exit("wake-host-deploy: WAKE_DB_PASSWORD is not in the environment")
    if not password.isalnum():
        sys.exit("wake-host-deploy: WAKE_DB_PASSWORD has non-alphanumerics, which the quoting path does not cover")
    return password


def step_db():
    password = db_password()
    role = sql_name("WAKE_DB_ROLE", DB_ROLE)
    name = sql_name("WAKE_DB_NAME", DB_NAME)
    body = (
        "DO $do$ BEGIN\n"
        f"  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{role}')\n"
        f"    THEN ALTER ROLE {role} LOGIN PASSWORD '{password}';\n"
        f"    ELSE CREATE ROLE {role} LOGIN PASSWORD '{password}';\n"
        "  END IF;\n"
        "END $do$;\n"
    )
    print("role:", host(f"{PSQL} -v ON_ERROR_STOP=1 -q -f -", data=body) or "ok")
    present = host_out(f"""{PSQL} -tAc "select 1 from pg_database where datname = '{name}'" """.strip())
    if present.strip() != "1":
        print("db:", host(f"{priv('createdb')} -O {role} {name}"))
    else:
        print("db: already present")
    owner = host_out(
        f"""{PSQL} -tAc "select pg_get_userbyid(datdba) from pg_database where datname='{name}'" """.strip()
    )
    print("owner:", owner)


def step_user():
    # The group comes first: `useradd --gid wake` fails with "group 'wake' does not exist" on a
    # clean host, and deploy/README.md's order (db, user, install, env, unit) then stops at step two.
    print(
        "group:",
        host(f"getent group {SERVICE_GROUP} >/dev/null || {priv('groupadd')} --system {SERVICE_GROUP}"),
    )
    found = host_out("getent passwd " + SERVICE_USER + " || true")
    if found.strip():
        print("user: exists ->", found.strip())
        return
    print(
        "user:",
        host(
            f"{priv('useradd')} --system --gid {SERVICE_GROUP} --home-dir {INSTALL_DIR} "
            f"--no-create-home --shell /usr/sbin/nologin {SERVICE_USER} && getent passwd {SERVICE_USER}"
        ),
    )


def git(root, *args, timeout=60):
    """One git command in the checkout: (ok, stdout, stderr). git's own failure is a value here."""
    try:
        r = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, "", str(exc)
    if r.returncode != 0:
        return False, "", r.stderr.strip()
    return True, r.stdout.rstrip("\n"), ""


def stop_build(problem):
    """Refuse the build, or under --dry-run name where a real run would stop and still plan."""
    if DRY:
        print(f"wake-host-deploy: note: a real run stops here: {problem}", file=sys.stderr)
        return False
    sys.exit(f"wake-host-deploy: {problem}")


def build_ref(root):
    """The commit this build ships, or a stop.

    `build` used to run the builder in whatever the shared clone had checked out: an unmerged
    branch, a half-rebased worktree or a bot's verification clone all looked like `main`, and
    the artifact carried no record of the tree it came from. So a deploy could ship a pull
    request nobody had merged and say nothing about it.

    A dirty checkout is refused because the built bytes would then be a commit plus edits
    nobody can name. HEAD must be origin/main's commit, which is what a release is cut from.
    WAKE_ALLOW_ANY_REF=1 is the deliberate hotfix: it builds the checked-out commit and says
    so on stderr, so the run is still attributable afterwards.
    """
    ok, _, why = git(root, "rev-parse", "--git-dir")
    if not ok:
        problem = (
            f"{root} is not a git checkout, so the build cannot be named by a commit: "
            f"WAKE_ALLOW_ANY_REF=1 builds it anyway ({why or 'not a repository'})"
        )
        if ALLOW_ANY_REF:
            print(
                f"wake-host-deploy: note: {root} is not a git checkout: building it on WAKE_ALLOW_ANY_REF",
                file=sys.stderr,
            )
            return None
        stop_build(problem)
        return None
    ok, dirty, why = git(root, "status", "--porcelain", "--untracked-files=all")
    if not ok:
        stop_build(f"cannot read the state of {root}: {why}")
        return None
    changed = [line[3:] for line in dirty.splitlines() if line.strip()]
    if changed:
        listed = ", ".join(changed[:5]) + (f" (+{len(changed) - 5} more)" if len(changed) > 5 else "")
        stop_build(
            f"{root} has uncommitted changes, so the build would not be a commit: {listed}: commit or stash them"
        )
        return None
    ok, head, why = git(root, "rev-parse", "HEAD")
    if not ok:
        stop_build(f"cannot read the commit in {root}: {why}")
        return None
    if DRY:
        print(f"  $ git -C {root} fetch origin")
    else:
        fetched, _, why = git(root, "fetch", "--quiet", "origin")
        if not fetched:
            print(
                "wake-host-deploy: note: git fetch failed, so origin/main is the last one seen: "
                + (why or "no output"),
                file=sys.stderr,
            )
    ok, main, _ = git(root, "rev-parse", "--verify", "--quiet", "origin/main")
    if not ok or not main:
        if ALLOW_ANY_REF:
            print(
                f"wake-host-deploy: note: {root} has no origin/main: building {head} on WAKE_ALLOW_ANY_REF",
                file=sys.stderr,
            )
            return head
        stop_build(
            f"{root} has no origin/main to compare with, so {head} cannot be called a release "
            f"tree: fetch it, or set WAKE_ALLOW_ANY_REF=1"
        )
        return head
    if head != main:
        if ALLOW_ANY_REF:
            print(
                f"wake-host-deploy: note: {root} is at {head}, not origin/main {main}: "
                "building it on WAKE_ALLOW_ANY_REF",
                file=sys.stderr,
            )
            return head
        stop_build(
            f"{root} is at {head}, not origin/main {main}: check out main, or set "
            f"WAKE_ALLOW_ANY_REF=1 to build this commit on purpose"
        )
        return head
    return head


MIGRATION = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]*\.sql\Z")


def tree_problem(root, commit):
    """Why this checkout no longer matches the build's commit, or None.

    build_ref reads HEAD, then the builder runs, then record_build wrote that commit: nothing
    looked at the tree in between. A builder that commits, merges or checks out while it runs
    therefore left an artifact nobody can name, stamped with a commit it does not belong to.
    Read the tree again, the same way build_ref does, and refuse to record a build that moved.
    """
    if not commit:
        # A checkout with no ref (WAKE_ALLOW_ANY_REF on a copied tree) has nothing to compare:
        # build_ref already said on stderr that this build cannot be named.
        return None
    ok, dirty, why = git(root, "status", "--porcelain", "--untracked-files=all")
    if not ok:
        return f"cannot re-read the state of {root} after the build: {why}"
    changed = [line[3:] for line in dirty.splitlines() if line.strip()]
    if changed:
        listed = ", ".join(changed[:5]) + (f" (+{len(changed) - 5} more)" if len(changed) > 5 else "")
        return (
            f"{root} changed while it was being built: {listed}: the artifact is not the commit "
            f"{commit or 'it started from'}, so nothing was recorded: build a tree nobody else is using"
        )
    ok, head, why = git(root, "rev-parse", "HEAD")
    if not ok:
        return f"cannot re-read the commit in {root} after the build: {why}"
    if commit and head != commit:
        return (
            f"{root} moved from {commit} to {head} while it was being built: the artifact belongs to "
            f"neither commit, so nothing was recorded: build a tree nobody else is using"
        )
    return None


def snapshot_migrations(root, out):
    """Copy the migrations into the build, so install ships the ones it was built with.

    install used to print the build's commit and then tar `apps/api/src/migrations` from the
    live checkout: an uncommitted .sql added after the build ran against the live database at
    the next boot, under a line that said the tree was main. The build now carries its own
    copy and install reads only that, so what is named and what is shipped are the same tree.
    """
    source = os.path.join(root, "apps", "api", "src", "migrations")
    names = sorted(n for n in os.listdir(source) if n.endswith(".sql")) if os.path.isdir(source) else []
    for name in names:
        if not MIGRATION.match(name):
            sys.exit(f"wake-host-deploy: {name} is not a migration name (letters, digits, dot, dash, underscore)")
    if not names:
        return []
    target = os.path.join(out, "migrations")
    os.makedirs(target, mode=0o700)
    for name in names:
        shutil.copyfile(os.path.join(source, name), os.path.join(target, name))
    return names


def step_build():
    root = os.environ.get("WAKE_REPO") or os.getcwd()
    entry = os.path.join(root, "apps/api/src/index.ts")
    if not os.path.isfile(entry):
        sys.exit(f"wake-host-deploy: no {entry}: set WAKE_REPO to the checkout")
    commit = build_ref(root)
    out = tempfile.mkdtemp(prefix="wake-build-")
    if DRY:
        print(f"  $ {BUILDER} build {entry} --target=node --outfile={out}/index.mjs")
        print(f"  $ git -C {root} status --porcelain --untracked-files=all  &  see the tree did not move")
        print(f"  $ copy {root}/apps/api/src/migrations/*.sql into {out}/migrations")
        print(f"  $ record {out} and {commit or '<commit>'} in {STATE_DIR}/last-build")
        return
    r = subprocess.run(
        [BUILDER, "build", entry, "--target=node", f"--outfile={out}/index.mjs"],
        cwd=root,
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        shutil.rmtree(out, ignore_errors=True)
        sys.exit(f"build failed: {r.stderr[-600:]}")
    try:
        problem = tree_problem(root, commit)
        if problem:
            sys.exit(f"wake-host-deploy: {problem}")
        names = snapshot_migrations(root, out)
    except SystemExit:
        shutil.rmtree(out, ignore_errors=True)
        raise
    record_build(out, commit)
    print("commit:", commit or "unknown")
    print("migrations:", len(names))
    print("size:", os.path.getsize(f"{out}/index.mjs"))


def require_private(path, consequence):
    """A directory is private when it is ours and nobody else can look in or write in it."""
    info = os.stat(path)
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        sys.exit(f"wake-host-deploy: {path} is not a private directory of yours: {consequence}")


def state_dir():
    """The deploy state directory: 0700, created here, and never a directory we did not make.

    record_build used to chmod whatever STATE_DIR named, so WAKE_DEPLOY_STATE=/tmp or any
    shared directory this operator owns but did not make came back 0700, and a directory
    someone else owns had a chmod aimed at it. The chmod now runs only on a directory this
    call created; one that already exists must already be private, and is refused rather
    than repaired.
    """
    try:
        os.makedirs(STATE_DIR, mode=0o700)
    except FileExistsError:
        if not os.path.isdir(STATE_DIR):
            sys.exit(f"wake-host-deploy: {STATE_DIR} is not a directory")
        require_private(STATE_DIR, "let this tool create it, or chmod 700 it")
        return
    os.chmod(STATE_DIR, 0o700)


def record_build(path, commit=None):
    """Remember this build and the commit it came from, so install cannot pick up someone else's.

    One file, two lines: the artifact path and the commit. Install reads the first and names
    the second, so "which tree is this?" is answered by the state rather than by memory.
    """
    state_dir()
    pointer = os.path.join(STATE_DIR, "last-build")
    tmp = pointer + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(path + "\n" + (commit + "\n" if commit else ""))
    os.chmod(tmp, 0o600)
    os.replace(tmp, pointer)


def build_dir():
    """The build this operator made, or a stop. Never a glob of the temp directory.

    Under --dry-run nothing is installed, so a record that a real run would refuse is named
    and the plan still prints: the dry run used to exit 1 before showing a single command.
    """
    pointer = os.path.join(STATE_DIR, "last-build")
    try:
        with open(pointer, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        if DRY:
            return None
        sys.exit("wake-host-deploy: no build recorded: run the build step first")
    made = lines[0].strip() if lines else ""
    problem = None
    if not made:
        problem = "no build recorded: run the build step first"
    elif not os.path.isdir(made):
        problem = f"the recorded build {made} is gone: run the build step again"
    else:
        info = os.stat(made)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            problem = f"{made} is not a private directory of yours: run the build step again"
        elif not os.path.isfile(os.path.join(made, "index.mjs")):
            problem = f"{made} has no index.mjs: run the build step again"
    if problem is None:
        return made
    if DRY:
        print(f"wake-host-deploy: note: a real run stops here: {problem}", file=sys.stderr)
        return made or None
    sys.exit(f"wake-host-deploy: {problem}")


def build_commit():
    """The commit recorded with the build, or None: what install shipped and status prints."""
    try:
        with open(os.path.join(STATE_DIR, "last-build"), encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    if len(lines) < 2:
        return None
    return lines[1].strip() or None


def migration_payload(directory):
    """One tar stream of the migrations, as base64 text, so no file is staged in /tmp."""
    names = sorted(n for n in os.listdir(directory) if n.endswith(".sql")) if os.path.isdir(directory) else []
    for name in names:
        if not MIGRATION.match(name):
            sys.exit(f"wake-host-deploy: {name} is not a migration name (letters, digits, dot, dash, underscore)")
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tar:
        for name in names:
            tar.add(os.path.join(directory, name), arcname=name)
    return names, base64.b64encode(buf.getvalue()).decode("ascii")


def installed_commit():
    """The commit install wrote beside the installed file: what the service is running now.

    `status` used to print the last build's commit from this operator's state directory, which
    answers a different question: build B after installing A said B while the host ran A.
    """
    out = host_out(f"cat {INSTALL_DIR}/index.commit 2>/dev/null || true", check=False)
    return out.strip() or None


def step_install():
    out = build_dir()
    commit = build_commit()
    print("install: commit", commit or "unknown (this build was recorded without one: run the build step again)")
    # check=False: a host without node prints nothing and exits 1, and host_out's default exit
    # would replace the actionable message below with "FAILED: command -v node" (#134).
    node = os.environ.get("WAKE_NODE") or host_out("command -v node", check=False)
    if not node:
        if DRY:
            print("  $ node: the host's `command -v node`")
            node = "<node>"
        else:
            sys.exit("wake-host-deploy: no node on the host: set WAKE_NODE")
    host(f"{priv('install')} -d -o root -g {SERVICE_GROUP} -m 755 {INSTALL_DIR} {INSTALL_DIR}/migrations")
    host(f"{priv('install')} -m 755 {shlex.quote(node)} {INSTALL_DIR}/node")
    if out is None:
        print(f"  $ put <build>/index.mjs -> {INSTALL_DIR}.index.mjs")
    else:
        put(os.path.join(out, "index.mjs"), f"{INSTALL_DIR}.index.mjs")
    host(
        f"{priv('install')} -o root -g {SERVICE_GROUP} -m 644 {INSTALL_DIR}.index.mjs {INSTALL_DIR}/index.mjs "
        # The staging file is root-owned now, so the cleanup has to be privileged too.
        f"&& {priv('rm')} -f {INSTALL_DIR}.index.mjs"
    )
    migrations = os.path.join(out, "migrations") if out else None
    names, payload = migration_payload(migrations) if migrations else ([], "")
    if not names:
        # An empty payload would prune every .sql on the host, so it means "this build carries
        # none": leave what is installed alone and say so.
        print("migrations: 0 (this build carries none: the host's migrations are left as they are)")
    if names:
        # One stream in, exact names out: a /tmp glob used to install whatever happened to match it.
        host(f"base64 -d | {priv('tar')} -x --no-same-owner -C {INSTALL_DIR}/migrations", data=payload)
        # A migration the checkout no longer has must not come back at the next boot.
        keep = " ".join(names)
        host(
            f'cd {INSTALL_DIR}/migrations && for f in *.sql; do [ -e "$f" ] || continue; '
            f'case " {keep} " in *" $f "*) ;; *) {priv("rm")} -f "$f" ;; esac; done'
        )
    # The directory exists either way (the `install -d` at the top of this step makes it), so a
    # chown here cannot fail on a build that carries no migrations (#106).
    host(f"{priv('chown')} -R root:{SERVICE_GROUP} {INSTALL_DIR}/migrations")
    if names:
        # Exact names, never a glob. `chmod 644 <dir>/*.sql` in a directory that matches
        # nothing hands chmod the literal pattern, chmod exits 1, and install reports FAILED
        # after index.mjs is already in place: a partial deploy that says nothing changed.
        files = " ".join(shlex.quote(name) for name in names)
        host(f"cd {INSTALL_DIR}/migrations && {priv('chmod')} 644 {files}")
    if commit:
        sidecar = os.path.join(out, "index.commit")
        with open(sidecar, "w", encoding="utf-8") as f:
            f.write(commit + "\n")
        put(sidecar, f"{INSTALL_DIR}.commit")
        host(
            f"{priv('install')} -o root -g {SERVICE_GROUP} -m 644 {INSTALL_DIR}.commit {INSTALL_DIR}/index.commit "
            f"&& {priv('rm')} -f {INSTALL_DIR}.commit"
        )
    else:
        # An unnamed build must not inherit the previous install's name.
        host(f"{priv('rm')} -f {INSTALL_DIR}/index.commit")
    print(host(f"ls -l {INSTALL_DIR} {INSTALL_DIR}/migrations | head -8"))


def merge_env(existing, values):
    """Keep every line the operator added; set the keys we own; no duplicates.

    Every value is checked here, where the lines are written, so a key nobody names is covered
    too: WAKE_MCP_ENABLED used to accept "true\\\\nINJECTED_EVIL=1" and add that line to the file.
    """
    managed = dict(values)
    for key, value in managed.items():
        no_control(key, value)
    lines = []
    seen = set()
    for line in existing.splitlines():
        key, sep, _ = line.partition("=")
        key = key.strip()
        if sep and key in managed and not line.lstrip().startswith("#"):
            if key in seen:
                continue
            lines.append(f"{key}={managed[key]}")
            seen.add(key)
            continue
        lines.append(line)
    for key, value in managed.items():
        if key not in seen:
            lines.append(f"{key}={value}")
    return "\n".join(line for line in lines if line.strip() != "") + "\n"


def no_control(name, value):
    """An environment file is lines: a value with a newline would add one of its own."""
    bad = next((c for c in value if ord(c) < 0x20 or ord(c) == 0x7F), None)
    if bad is not None:
        sys.exit(f"wake-host-deploy: {name} has a control character ({bad!r}), which would break the environment file")


# The three answers env_file_text() asks for. A real api.env carries KEY=VALUE lines, so a
# marker line cannot be mistaken for content.
ENV_READ = "__wake_env:read__"
ENV_UNREADABLE = "__wake_env:unreadable__"
ENV_ABSENT = "__wake_env:absent__"


def parse_env_answer(answer):
    """The state the one shell answer names, and the file's text when it was read.

    The marker is the LAST line and the shell prints a newline before it: `cat` of a file whose
    last line has no newline used to glue the marker onto the value (`5__wake_env:read__`), so the
    last line matched no state, this returned "", and the rewrite dropped every key - the failure
    #131 is about, reintroduced by reading only the last line. A line that is none of the three
    states is a refusal, never an empty file, and so is an answer that names nothing at all: a
    transport that exits 0 with no stdout used to read as an absent file (#146 F3). The refusal
    names the line's length, never the line: an api.env's last line is normally a KEY=value, and
    the two that matter carry the database password and the registration secret (#146 F1).
    """
    lines = answer.splitlines()
    if not lines:
        sys.exit(
            f"wake-host-deploy: the answer that names {ENV_FILE}'s state named none of "
            f"{ENV_READ}, {ENV_UNREADABLE} or {ENV_ABSENT}; refusing to rewrite the file "
            "(an answer that prints nothing is not an empty file)"
        )
    state = lines[-1]
    if state == ENV_READ:
        return "\n".join(lines[:-1])
    if state == ENV_UNREADABLE:
        sys.exit(
            f"wake-host-deploy: {ENV_FILE} exists but could not be read; refusing to rewrite it, "
            "which would drop every key it carries"
        )
    if state == ENV_ABSENT:
        return ""
    sys.exit(
        f"wake-host-deploy: the last line of the answer that names {ENV_FILE}'s state was "
        f"{len(state)} characters long and matched none of {ENV_READ}, {ENV_UNREADABLE} or "
        f"{ENV_ABSENT}; refusing to rewrite the file (the line is not repeated here: it is "
        "normally a KEY=value, and two of those carry a secret)"
    )


def env_file_text():
    """The live environment file's text, or a refusal when it exists and cannot be read.

    `cat FILE 2>/dev/null || true` answered the same for a missing file and for a read this
    account was not allowed to make, so a refused read merged into an empty string and the
    rewrite silently dropped every key the file carried (#131). One command names the case.
    """
    path = shlex.quote(ENV_FILE)
    # The newline before the marker is load-bearing: without it the marker lands on the end of the
    # file's last line whenever that line has no newline of its own.
    answer = host_out(
        f"if {priv('cat')} {path}; then printf '\\n%s\\n' {ENV_READ}; "
        f"elif {priv('test')} -e {path}; then echo {ENV_UNREADABLE}; "
        f"else echo {ENV_ABSENT}; fi"
    )
    return parse_env_answer(answer)


def step_env():
    password = db_password()
    secret = os.environ.get("WAKE_REGISTRATION_SECRET")
    if not secret:
        sys.exit("wake-host-deploy: WAKE_REGISTRATION_SECRET is not in the environment")
    no_control("WAKE_REGISTRATION_SECRET", secret)
    # The API refuses to boot with a shorter value (apps/api/src/options.ts), so writing one
    # would leave a file that cannot start. Refuse before the host is touched.
    if len(secret) < 32:
        sys.exit(
            "wake-host-deploy: WAKE_REGISTRATION_SECRET must be at least 32 characters, or the API will refuse to start"
        )
    values = {
        "DATABASE_URL": f"postgres://{DB_ROLE}:{password}@{DB_HOST}:{DB_PORT}/{DB_NAME}",
        "HOST": BIND,
        "PORT": PORT,
        "REGISTRATION_SECRET": secret,
        # Off unless the operator says so: re-imposing "true" silently republishes an endpoint
        # that was halted on purpose.
        "WAKE_MCP_ENABLED": os.environ.get("WAKE_MCP_ENABLED", "false"),
    }
    # merge_env refuses these too; checked here so a refusal costs no host command at all.
    for key, value in values.items():
        no_control(key, value)
    existing = "" if DRY else env_file_text()
    body = merge_env(existing, values)
    directory = os.path.dirname(ENV_FILE)
    host(f"{priv('install')} -d -o root -g {SERVICE_GROUP} -m 750 {directory}")
    # Write beside the live file and rename over it: a write that fails or is interrupted then
    # leaves the service its working environment file instead of an empty one. A rename
    # replaces a symlinked api.env instead of writing through it, which is the safe direction.
    staged = ENV_FILE + ".new"
    host(f"{priv('install')} -o root -g {SERVICE_GROUP} -m 640 /dev/null {staged}")
    host(f"{priv('tee')} {staged} >/dev/null", data=body)
    host(f"{priv('mv')} -f {staged} {ENV_FILE}")
    print(host(f"{priv('ls')} -l {ENV_FILE}"))


def step_unit():
    body = UNIT.format(
        service=SERVICE,
        user=SERVICE_USER,
        group=SERVICE_GROUP,
        dir=INSTALL_DIR,
        env_file=ENV_FILE,
        node=f"{INSTALL_DIR}/node",
    )
    host(f"{priv('tee')} {UNIT_DIR}/{SERVICE}.service >/dev/null", data=body)
    print(host(f"{priv('systemctl')} daemon-reload && {priv('systemctl')} enable --now {SERVICE}.service"))


def step_status():
    print(host(f"systemctl is-enabled {SERVICE}.service; systemctl is-active {SERVICE}.service"))
    print(host(f"{priv('systemctl')} status {SERVICE}.service --no-pager -l | head -12"))
    print(host(f"curl -fsS http://127.0.0.1:{PORT}/health; echo"))
    print(
        "installed commit:",
        installed_commit() or "unknown (no record beside the installed file: install again to write one)",
    )


def step_log():
    print(host(f"{priv('journalctl')} -u {SERVICE}.service -n 40 --no-pager | tail -40"))


STEPS = {
    "db": step_db,
    "user": step_user,
    "build": step_build,
    "install": step_install,
    "env": step_env,
    "unit": step_unit,
    "status": step_status,
    "log": step_log,
}


def main(argv):
    global DRY
    steps = []
    for arg in argv:
        if arg in ("-h", "--help", "help"):
            usage()
            return 0
        if arg == "--dry-run":
            DRY = True
            continue
        if arg not in STEPS:
            print(f"wake-host-deploy: unknown step: {arg}", file=sys.stderr)
            usage()
            return 2
        steps.append(arg)
    if transport("") is None:
        print("wake-host-deploy: set WAKE_HOSTOPS or WAKE_HOST_SSH", file=sys.stderr)
        return 2
    for name in steps or ["status"]:
        print(f"--- {name}")
        STEPS[name]()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
