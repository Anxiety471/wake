#!/bin/bash
# desc: wake --ask every open bot in the registry at once, one log per bot; arguments pick bots by alias instead. Reads WAKE_REGISTRY, WAKE_PING_LOG_DIR, WAKE_PING_TIMEOUT, WAKE_PING_MESSAGE
set -u

CFG=${WAKE_CONFIG_DIR:-$HOME/.config/wake}
# Same default as bin/wake and wake-keys: the registry lives in the config dir.
REG=${WAKE_REGISTRY:-$CFG/bots.tsv}
LOG_DIR=${WAKE_PING_LOG_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/wake/pingall}
WAIT=${WAKE_PING_TIMEOUT:-240}
MSG=${WAKE_PING_MESSAGE:-ping test: reply with the word pong only}

usage() {
    cat <<'EOF'
usage: wake-pingall [ALIAS ...]

  Asks every open bot in the registry at once, in the background, one log per bot. Aliases
  given as arguments pick the bots instead. It starts the asks and returns: it does not wait
  for the answers, and the logs are where the answers land.

  environment   WAKE_REGISTRY        the bot registry ($WAKE_CONFIG_DIR/bots.tsv)
                WAKE_CONFIG_DIR      default ~/.config/wake
                WAKE_PING_LOG_DIR    where <alias>.log goes ($XDG_CACHE_HOME/wake/pingall)
                WAKE_PING_TIMEOUT    seconds each ask waits (240)
                WAKE_PING_MESSAGE    the question (a one-word pong check by default)

  An alias that is empty, starts with a hyphen, or is not letters, digits, hyphen and underscore
  is named and skipped - it becomes a file name, and ../x would write outside the log directory,
  while -x would be read as a flag by wake - and the rest of the batch runs; the exit code is
  then 2.

  exit 0 when the asks were started, 1 when there is no registry, no open bot, or no wake on
  PATH, 2 when an alias was refused (the rest still ran) or none was left to ping
EOF
}

case ${1:-} in
    -h | --help)
        usage
        exit 0
        ;;
esac

# Kept as an array: "$*" re-split the aliases on whitespace and dropped empty words, so
# `wake-pingall "a b"` asked two bots called a and b, and `wake-pingall ""` started nothing.
LIST=()
if [ "$#" -gt 0 ]; then
    LIST=("$@")
else
    [ -r "$REG" ] || {
        echo "no registry at $REG (set WAKE_REGISTRY, or pass bot aliases as arguments)" >&2
        exit 1
    }
    FOUND=0
    while IFS= read -r alias; do
        [ -n "$alias" ] && {
            LIST+=("$alias")
            FOUND=1
        }
    done < <(awk -F'\t' 'NF >= 4 && $4 == "open" && $1 != "" { print $1 }' "$REG")
    # Not ${#LIST[@]} on a possibly empty array: bash before 4.4 fails that under `set -u`.
    [ "$FOUND" = 1 ] || {
        echo "no open bots in $REG" >&2
        exit 1
    }
fi

command -v wake >/dev/null || {
    echo "wake not found on PATH; run ./install.sh first" >&2
    exit 1
}

mkdir -p "$LOG_DIR"
# An alias becomes both an argument (`wake --ask <alias>`) and a file name ($LOG_DIR/<alias>.log),
# so it is checked before either: `../x` would write outside the log directory, `-x` would be read
# as a flag by wake, and a blank one names no bot. One bad alias is named and skipped, the rest of
# the batch still runs, and the exit code says one was refused.
STARTED=()
PINGED=0
REFUSED=0
for alias in "${LIST[@]}"; do
    case $alias in
        *[![:space:]]*) ;;
        *)
            echo "wake-pingall: bad bot alias '$alias' (an empty alias names no bot); skipped" >&2
            REFUSED=1
            continue
            ;;
    esac
    case $alias in
        -*)
            echo "wake-pingall: bad bot alias '$alias' (an alias never starts with a hyphen); skipped" >&2
            REFUSED=1
            continue
            ;;
        *[!A-Za-z0-9_-]*)
            echo "wake-pingall: bad bot alias '$alias' (letters, digits, hyphen and underscore only); skipped" >&2
            REFUSED=1
            continue
            ;;
    esac
    nohup wake --ask "$alias" "$MSG" --wait "$WAIT" </dev/null >"$LOG_DIR/$alias.log" 2>&1 &
    STARTED+=("$alias")
    PINGED=1
done
[ "$PINGED" = 1 ] || {
    echo "wake-pingall: no alias left to ping" >&2
    exit 2
}
echo "started: ${STARTED[*]} (logs in $LOG_DIR)"
[ "$REFUSED" = 0 ] || exit 2
