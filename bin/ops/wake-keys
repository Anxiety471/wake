#!/bin/bash
# desc: copy webhook keys that were minted on the host into this machine's key dir; prints ok/skip/bad/none/err per bot and never a key value. Uses WAKE_HOSTOPS, WAKE_HOST_KEY_DIR, WAKE_KEY_DIR, WAKE_CONFIG_DIR, WAKE_REGISTRY
set -u
# The temporary key file must not be readable by anyone else, even for the
# moment between the fetch and its chmod 600.
umask 077

HOSTOPS=${WAKE_HOSTOPS:-}

# Every location comes from the resolver the CLI ships with (bin/wake_config.py, beside this
# helper or a directory or two up), so the environment, the user's config file, the site file
# and the default are read in the one order bin/wake uses. Asking it for the store alone left
# WAKE_CONFIG_DIR, WAKE_KEY_DIR and WAKE_REGISTRY environment-only (#135 review). A bare copy
# of bin/ops on a machine without the resolver keeps the environment and the defaults below.
resolve() {
    local d
    for d in "$(dirname "$0")" "$(dirname "$0")/.." "$(dirname "$0")/../.."; do
        [ -r "$d/wake_config.py" ] || continue
        (cd "$d" && python3 -c 'import wake_config; c = wake_config.load(); print("\n".join([c["WAKE_CONFIG_DIR"], c["WAKE_KEY_DIR"], c["WAKE_STATE_DIR"], c["WAKE_REGISTRY"], c["WAKE_HOSTOPS"]]))' 2>/dev/null) && return 0
    done
    return 1
}

usage() {
    cat <<'EOF'
usage: wake-keys [--force]

  Copies the webhook keys that were minted on the host into this machine's key dir, one
  <bot-id>.key at mode 600, and prints one line per bot: ok, skip, bad, none or err.
  It never prints a key value.

  --force      re-copy a key that is already saved (skip is the default)
  -h, --help   this text

  A key it could not fetch prints err with the host's first line, never none: only a missing
  file means the key really is absent, so a dead host cannot look like a bot with no key.

  environment   WAKE_REGISTRY        the bot registry ($WAKE_CONFIG_DIR/bots.tsv)
                WAKE_CONFIG_DIR      default ~/.config/wake
                WAKE_KEY_DIR         where keys are saved (defaults to WAKE_CONFIG_DIR)
                WAKE_HOST_KEY_DIR    where the host keeps <bot-id>.key (default: WAKE_STATE_DIR
                                     from the environment or the config files, then /var/lib/wake)
                WAKE_HOSTOPS         the command that reaches the host, from a guest

  exit 0 when every bot was ok, skip or none; 1 when a saved key was bad, a fetch failed, or
  there is no registry; 2 for an argument it does not take
EOF
}

# Nothing is resolved before this point: --help used to import the resolver to print usage.
case ${1:-} in
    -h | --help)
        usage
        exit 0
        ;;
    '') force=0 ;;
    --force) force=1 ;;
    *)
        echo "wake-keys: unknown argument '$1'; the only one it takes is --force (try --help)" >&2
        exit 2
        ;;
esac

# The resolver runs once, and only for a real run. WAKE_HOST_KEY_DIR is this helper's own
# name for the host store and wins over the resolver's WAKE_STATE_DIR.
CFG=""
KEY_DIR=""
STORE=""
REG=""
RESOLVED_HOSTOPS=""
resolved=$(resolve) || resolved=""
resolver=0
if [ -n "$resolved" ]; then
    # One value per line. A tab is IFS *whitespace*, so `IFS=$'\t' read` collapsed an empty
    # field and shifted every later value one place left: a site file naming `WAKE_KEY_DIR=`
    # made the host store the key dir and the registry the store, then said "no registry"
    # while the file named a readable one (#152).
    { read -r CFG; read -r KEY_DIR; read -r STORE; read -r REG; read -r RESOLVED_HOSTOPS; } <<< "$resolved"
    resolver=1
fi
# WAKE_HOSTOPS is not a path this helper derives: wake_config.load() reads it from the site and
# user files and bin/wake-inbox-io talks to the host through that value. Without this the helper
# took it from the environment only, so a machine whose bridge is named in its config file never
# called the host and printed "none (no key in the host store)" for every bot (#152).
[ -n "$HOSTOPS" ] || HOSTOPS=${RESOLVED_HOSTOPS:-}
HOST_KEY_DIR=${WAKE_HOST_KEY_DIR:-${STORE:-${WAKE_STATE_DIR:-}}}
[ -n "$CFG" ] || CFG=${WAKE_CONFIG_DIR:-$HOME/.config/wake}
[ -n "$KEY_DIR" ] || KEY_DIR=${WAKE_KEY_DIR:-$CFG}
# The registry sits in the config dir, where bin/wake looks, so moving the saved keys with
# WAKE_KEY_DIR never hides it.
if [ -z "$REG" ] && [ "$resolver" -eq 1 ]; then
    # load() answers the default when WAKE_REGISTRY is unset, so an empty value came from a
    # config that names one. Reading a different file than the config asked for is the helper
    # disagreeing with bin/wake: say it instead (#152 nit).
    echo "wake-keys: WAKE_REGISTRY names an empty value, which is no registry at all; unset it to use $CFG/bots.tsv" >&2
    exit 1
fi
[ -n "$REG" ] || REG=${WAKE_REGISTRY:-$CFG/bots.tsv}
[ -n "$HOST_KEY_DIR" ] || HOST_KEY_DIR=/var/lib/wake

[ -r "$REG" ] || {
    echo "no registry at $REG (set WAKE_REGISTRY, or copy bots.example.tsv there and fill it in)" >&2
    exit 1
}
mkdir -p "$KEY_DIR"

tmp=""
err=""
trap '[ -n "$tmp" ] && rm -f "$tmp"; [ -n "$err" ] && rm -f "$err"' EXIT

# A bot id is a path component and a shell word on the host, so it is checked first.
valid_id() {
    case $1 in
        '' | *[!A-Za-z0-9_-]*) return 1 ;;
    esac
    return 0
}

# fetch writes one key to $tmp without printing it: through WAKE_HOSTOPS when that is set,
# from the key dir directly when wake runs on the host itself. The error text goes to $err so a
# failed fetch (a dead host, a refused account) is not reported as a bot that has no key.
fetch() {
    if [ -n "$HOSTOPS" ]; then
        "$HOSTOPS" "sudo cat $HOST_KEY_DIR/$1.key" </dev/null >"$tmp" 2>"$err"
    else
        cat "$HOST_KEY_DIR/$1.key" >"$tmp" 2>"$err"
    fi
}

ok=0
skip=0
bad=0
miss=0
fail=0
while IFS="$(printf '\t')" read -r alias id _rest <&3; do
    case ${alias:-} in '' | '#'*) continue ;; esac
    [ -n "${id:-}" ] || continue
    if ! valid_id "$id"; then
        echo "bad   $alias (bot id $id is not letters, digits, underscore or dash)"
        bad=$((bad + 1))
        continue
    fi
    dest="$KEY_DIR/$id.key"
    if [ -s "$dest" ] && [ "$force" -ne 1 ]; then
        if [ -r "$dest" ]; then
            echo "skip  $alias (key already saved)"
            skip=$((skip + 1))
        else
            echo "bad   $alias (file present but not readable by $(id -un): $(stat -c '%U:%G %a' "$dest"))"
            bad=$((bad + 1))
        fi
        continue
    fi
    tmp="$KEY_DIR/.tmp-$id"
    err="$KEY_DIR/.tmp-$id.err"
    rc=0
    fetch "$id" || rc=$?
    if [ "$rc" -eq 0 ] && [ -s "$tmp" ]; then
        chmod 600 "$tmp"
        mv "$tmp" "$dest"
        rm -f "$tmp" "$err"
        tmp=""
        err=""
        if [ -r "$dest" ]; then
            echo "ok    $alias"
            ok=$((ok + 1))
        else
            echo "bad   $alias (saved but owned by $(stat -c '%U:%G' "$dest")); needs a host chown"
            bad=$((bad + 1))
        fi
    else
        why=""
        # "No such file or directory" is the one failure that means the key really is absent.
        if [ -s "$err" ] && ! grep -qi "no such file" "$err"; then
            why=$(head -n 1 "$err")
        elif [ ! -s "$err" ] && [ "$rc" -ne 0 ]; then
            why="exit $rc with no message"
        elif [ "$rc" -eq 0 ]; then
            why="the host returned an empty key file"
        fi
        rm -f "$tmp" "$err"
        tmp=""
        err=""
        if [ -n "$why" ]; then
            echo "err   $alias (host fetch failed: $why)"
            fail=$((fail + 1))
        else
            echo "none  $alias (no key in the host store)"
            miss=$((miss + 1))
        fi
    fi
done 3<"$REG"

echo "saved $ok, skipped $skip, unreadable $bad, no key $miss, failed $fail"
[ "$bad" -eq 0 ] && [ "$fail" -eq 0 ]
