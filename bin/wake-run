#!/usr/bin/env python3
# desc: run any command and wake a bot when it ends (ok on exit 0, error otherwise, incl. startup failures). Usage: wake-run [--bot BOT] [--only-errors] [--name label] -- cmd args...
import argparse, os, subprocess, sys, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wake_config  # noqa: E402

p = argparse.ArgumentParser()
p.add_argument("--bot", default=wake_config.load()["WAKE_BOT"])
p.add_argument("--only-errors", action="store_true")
p.add_argument("--name", default="")
p.add_argument("cmd", nargs=argparse.REMAINDER)
a = p.parse_args()
cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
if not cmd:
    sys.exit("usage: wake-run [--bot BOT] [--only-errors] [--name label] -- cmd args...")
label = a.name or os.path.basename(cmd[0])
env = dict(os.environ, WAKE_DEPTH=str(int(os.environ.get("WAKE_DEPTH", "0") or 0) + 1))
t0 = time.time()
try:
    rc = subprocess.call(cmd, env=env)
except FileNotFoundError:
    rc = 127
secs = int(time.time() - t0)
if rc != 0 or not a.only_errors:
    level = "ok" if rc == 0 else "error"
    detail = f"{label} exited {rc} after {secs}s in {os.path.basename(os.getcwd())}"
    subprocess.run(["wake", a.bot, detail, "--source", f"harness:{label}", "--event", "command_end", "--level", level],
                   env=dict(os.environ), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
sys.exit(rc)
