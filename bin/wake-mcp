#!/usr/bin/env python3
# desc: MCP stdio server for wake. With WAKE_MCP_TOKEN set it is a bridge: every message on stdin goes to POST /mcp and the reply comes back on stdout, so a stdio-only client gets the server's ten thread tools with no second tool table. Without a token it is the legacy two-tool CLI helper (wake_bot, wake_list).
import http.client
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wake_config  # noqa: E402

CFG = wake_config.load()
TOKEN = (CFG.get("WAKE_MCP_TOKEN") or "").strip()
API = ((CFG.get("WAKE_MCP_API") or "").strip() or "http://127.0.0.1:3001").rstrip("/")
TIMEOUT = 60.0
# The interpreter's default agent (Python-urllib/*) is refused by Cloudflare with
# 403 error 1010, so the public /mcp was unreachable from here while curl reached
# it. The CLI names itself the same way: wake-cli/<version> in bin/wake.
USER_AGENT = "wake-mcp/" + wake_config.VERSION


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """A 3xx is an answer, not an instruction: do not follow it.

    urllib re-sends every header on a redirect, Authorization included, and
    turns a redirected POST into a GET, so a 301 from a proxy or a moved path
    would hand the mcp token to whatever host Location names. The doorbell
    made the same call (redirect: manual).
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(_NoRedirect)

FLEET_TOOL = {
    "name": "wake_fleet",
    "description": (
        "List the bots in this machine's routing table (WAKE_REGISTRY, bots.tsv) with alias, name, "
        "kind and role: the fleet the wake CLI reaches by alias. These are not the same as the "
        "agents registered on this server, which wake_ask and wake_send address: those are wake_bots."
    ),
    "inputSchema": {"type": "object", "additionalProperties": False, "properties": {}},
}


def fleet():
    """The local routing table as rows, or (None, path) when there is no readable registry."""
    path = CFG.get("WAKE_REGISTRY") or ""
    try:
        with open(path) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None, path
    bots = []
    for line in lines:
        line = line.rstrip("\n")
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        fields = line.split("\t")
        if len(fields) < 2 or not fields[0].strip():
            continue
        fields += [""] * (5 - len(fields))
        alias = fields[0].strip()
        bots.append(
            {
                "alias": alias,
                "id": fields[1].strip(),
                "name": fields[2].strip(),
                "kind": fields[3].strip(),
                "role": fields[4].strip(),
                "reach": "wake " + alias + ' "<message>" or wake --ask ' + alias + ' "<question>"',
            }
        )
    return bots, path


LEGACY_TOOLS = [
    {
        "name": "wake_bot",
        "description": "Wake one of the registered bots (see wake_list) with a short message. Use level error for failures, info for a request, ok for a quiet note. Private bots are refused.",
        "inputSchema": {
            "type": "object",
            "required": ["bot", "message"],
            "properties": {
                "bot": {"type": "string"},
                "message": {"type": "string", "maxLength": 500},
                "level": {"type": "string", "enum": ["ok", "error", "info"]},
                "ref": {"type": "string"},
            },
        },
    },
    {
        "name": "wake_list",
        "description": "List bots that can be woken.",
        "inputSchema": {"type": "object", "properties": {}},
    },
]


def emit(message):
    sys.stdout.write(json.dumps(message, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def note(text):
    sys.stderr.write(text.rstrip() + "\n")
    sys.stderr.flush()


def error_body(rid, message):
    return {"jsonrpc": "2.0", "id": rid, "error": {"code": -32603, "message": message}}


def is_reply(document):
    """The server's JSON-RPC reply, not one of the API's own error bodies.

    A rejected token or a disabled endpoint answers with the REST shape,
    {"error": "unauthorized"}: no jsonrpc, and "error" is a string. Relayed
    as-is a conforming client drops it, and its call waits for a reply that
    has already arrived.
    """
    return (
        isinstance(document, dict)
        and document.get("jsonrpc") == "2.0"
        and ("result" in document or "error" in document)
    )


class Transport(Exception):
    """No usable reply. The message is the whole reason, API included."""


def post(message, version):
    headers = {
        "authorization": "Bearer " + TOKEN,
        "content-type": "application/json",
        "accept": "application/json, text/event-stream",
        "user-agent": USER_AGENT,
    }
    if version:
        headers["mcp-protocol-version"] = version
    request = urllib.request.Request(
        API + "/mcp",
        data=json.dumps(message).encode(),
        headers=headers,
        method="POST",
    )
    try:
        with OPENER.open(request, timeout=TIMEOUT) as response:
            return response.status, response.headers.get("content-type", ""), response.read()
    except urllib.error.HTTPError as error:
        # A 3xx lands here too: with no redirect handler there is no second request.
        try:
            body = error.read()
        except (http.client.HTTPException, OSError):
            body = b""
        received = error.headers.get("content-type", "") if error.headers else ""
        return error.code, received, body
    except urllib.error.URLError as error:
        raise Transport("wake API unreachable at " + API + ": " + str(getattr(error, "reason", error))) from error
    except http.client.HTTPException as error:
        # IncompleteRead is an HTTPException, not an OSError: a body cut short by
        # a proxy or a restarting API used to end the whole client session.
        raise Transport(
            "wake API cut the reply short at " + API + ": " + (str(error) or type(error).__name__)
        ) from error
    except OSError as error:
        raise Transport("wake API unreachable at " + API + ": " + str(error)) from error


def payloads(content_type, raw):
    """The reply as JSON-RPC documents: a JSON body, or the data of one SSE event."""
    text = raw.decode("utf-8", "replace")
    if "text/event-stream" not in content_type:
        return [text] if text.strip() else []
    out = []
    data = []
    for line in text.splitlines():
        if line.startswith("data:"):
            data.append(line[5:].lstrip())
        elif not line.strip() and data:
            out.append("\n".join(data))
            data = []
    if data:
        out.append("\n".join(data))
    return out


def line_id(line):
    """Best effort: the id a line asks about, for the crash guard below."""
    try:
        message = json.loads(line)
    except ValueError:
        return None
    return message.get("id") if isinstance(message, dict) else None


def bridge_line(line, state):
    try:
        message = json.loads(line)
    except ValueError:
        emit({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}})
        return
    if isinstance(message, list):
        emit(
            {
                "jsonrpc": "2.0",
                "id": None,
                "error": {"code": -32600, "message": "batching is not supported"},
            }
        )
        return
    rid = message.get("id")
    params = message.get("params") if isinstance(message.get("params"), dict) else {}
    if message.get("method") == "tools/call" and params.get("name") == "wake_fleet":
        # Local by design: the routing table lives on this machine, not on the server.
        bots, path = fleet()
        if bots is None:
            text, failed = "no routing table at " + path + " (WAKE_REGISTRY)", True
        else:
            text, failed = json.dumps({"registry": path, "bots": bots}, ensure_ascii=False), False
        emit(
            {
                "jsonrpc": "2.0",
                "id": rid,
                "result": {"content": [{"type": "text", "text": text}], "isError": failed},
            }
        )
        return
    # The API tells the two apart the same way: no "id" key is a notification,
    # while "id": null is a request and gets a null-id answer. MCP ids are
    # string|number, so null is outside the id space, but silence is worse.
    notification = "id" not in message
    try:
        status, content_type, raw = post(message, state.get("version"))
    except Transport as failure:
        if notification:
            note("wake-mcp: " + str(failure))
        else:
            emit(error_body(rid, str(failure)))
        return
    bodies = payloads(content_type, raw)
    if not bodies:
        if not notification:
            # An empty 200/202 used to be silence, and silence is a client
            # waiting for an answer that will never come.
            emit(error_body(rid, "HTTP " + str(status) + ": empty reply"))
        return
    # A 3xx is a statement about where the endpoint is, not a reply: its body
    # belongs to the redirect even when it is shaped like JSON-RPC. Every other
    # status may carry a real reply - a 429 does (decided before the body is
    # parsed), a 401 carries the API's own REST error instead.
    answered = not 300 <= status < 400
    for body in bodies:
        if notification:
            # A notification is never answered, whatever the server sends back.
            note("wake-mcp: dropped a reply to a notification: " + body.strip()[:300])
            continue
        try:
            reply = json.loads(body)
        except ValueError:
            reply = None
        if answered and isinstance(reply, dict) and "method" in reply:
            # A server-initiated message (notifications/progress and friends)
            # belongs to no request: forward it as it came, never as an error.
            emit(reply)
        elif answered and is_reply(reply):
            result = reply.get("result")
            if isinstance(result, dict) and isinstance(result.get("protocolVersion"), str):
                state["version"] = result["protocolVersion"]
            if isinstance(result, dict) and isinstance(result.get("tools"), list):
                bots, _ = fleet()
                if bots is not None and not any(
                    isinstance(tool, dict) and tool.get("name") == "wake_fleet" for tool in result["tools"]
                ):
                    result["tools"].append(FLEET_TOOL)
            if reply.get("id") != rid:
                # A 429 is decided before the body is parsed, so it carries
                # id: null. A client matches replies by id: answer on the id
                # that asked, or the call hangs until its own timeout.
                reply["id"] = rid
            emit(reply)
        else:
            emit(error_body(rid, "HTTP " + str(status) + ": " + body.strip()[:300]))


def run_bridge():
    state = {}
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            bridge_line(line, state)
        except Exception as error:  # one bad answer must never end the session
            note("wake-mcp: internal error: " + type(error).__name__ + ": " + str(error))
            rid = line_id(line)
            if rid is not None:
                emit(error_body(rid, "internal bridge error: " + type(error).__name__))


def legacy_call(name, arguments):
    if name == "wake_list":
        command = ["wake", "--list"]
    elif name == "wake_bot":
        command = [
            "wake",
            str(arguments["bot"]),
            str(arguments["message"])[:500],
            "--source",
            "harness:mcp",
            "--level",
            arguments.get("level", "info"),
        ]
        if arguments.get("ref"):
            command += ["--ref", str(arguments["ref"])]
    else:
        return "unknown tool", True
    result = subprocess.run(command, capture_output=True, text=True, timeout=60)
    return (result.stdout + result.stderr).strip() or "(no output)", result.returncode != 0


def run_legacy():
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except ValueError:
            continue
        rid, method = message.get("id"), message.get("method")
        if rid is None:
            continue
        if method == "initialize":
            emit(
                {
                    "jsonrpc": "2.0",
                    "id": rid,
                    "result": {
                        "protocolVersion": "2024-11-05",
                        "capabilities": {"tools": {}},
                        "serverInfo": {"name": "wake", "version": wake_config.VERSION},
                    },
                }
            )
        elif method == "tools/list":
            emit({"jsonrpc": "2.0", "id": rid, "result": {"tools": LEGACY_TOOLS}})
        elif method == "tools/call":
            params = message.get("params", {})
            try:
                text, failed = legacy_call(params.get("name"), params.get("arguments") or {})
            except Exception as error:  # the tool call is the boundary, not a crash
                text, failed = str(error), True
            emit(
                {
                    "jsonrpc": "2.0",
                    "id": rid,
                    "result": {"content": [{"type": "text", "text": text}], "isError": failed},
                }
            )
        else:
            emit(
                {
                    "jsonrpc": "2.0",
                    "id": rid,
                    "error": {"code": -32601, "message": "method not found"},
                }
            )


LOOPBACK = ("127.0.0.1", "localhost", "::1")


def check_settings():
    """Warnings only, on stderr: nothing here may print the token."""
    parts = urllib.parse.urlsplit(API)
    if parts.scheme == "http" and parts.hostname not in LOOPBACK + (None,):
        note(
            "wake-mcp: WAKE_MCP_API is plain http to "
            + str(parts.hostname)
            + ", so the token crosses the network in clear; use https or a loopback/tunnel address"
        )
    path = os.path.expanduser(
        os.environ.get("WAKE_CONFIG") or os.path.join(CFG.get("WAKE_CONFIG_DIR") or "", "config.env")
    )
    try:
        mode = os.stat(path).st_mode & 0o777
    except OSError:
        return
    if mode & 0o077:
        note("wake-mcp: " + path + " is mode " + format(mode, "o") + "; keep the token file at 600")


HELP = """\
usage: wake-mcp [--help]

  The MCP stdio server. With WAKE_MCP_TOKEN set it is a bridge: every JSON-RPC message on stdin
  goes to POST $WAKE_MCP_API/mcp with that bearer, and the answer comes back on stdout. A
  stdio-only client gets the server's ten thread tools, with the same rate limit, audit and
  private-bot wall as an HTTP client.
  Without a token it keeps the legacy two-tool mode (wake_bot, wake_list), which shells out to
  wake. That mode is only entered when WAKE_CONFIG is unset: a WAKE_CONFIG that names a missing
  or tokenless file exits 2 instead, because silently answering with two tools looks like a
  working session (issue #76).

  wake_fleet is answered here, not by the API: it lists this machine's routing table
  (WAKE_REGISTRY, bots.tsv) - alias, name, kind, role - and it is only advertised when that
  file is readable. The agents registered on the server stay wake_bots.

  A redirect is never followed: urllib re-sends Authorization on one, so a 3xx would hand the
  token to whatever host Location names. A stale or rotated token, a disabled /mcp endpoint and a
  503 all arrive as a JSON-RPC error on the asking id, never as a dropped message.

  stdout carries JSON-RPC only; warnings go to stderr and never include the token.

  environment   WAKE_MCP_TOKEN   the mcp identity's token (unset: legacy mode)
                WAKE_MCP_API     API base (http://127.0.0.1:3001); https for any other host
"""


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(HELP, end="")
        sys.exit(0)
    if TOKEN:
        check_settings()
        run_bridge()
    else:
        # A client that named a config file asked for the bridge. Falling back to the
        # two-tool helper there is a silent downgrade: it answers every method and
        # lists two tools, so nothing looks wrong (issue #76).
        explicit = os.environ.get("WAKE_CONFIG")
        if explicit:
            path = os.path.expanduser(explicit)
            if not os.path.exists(path):
                note(
                    "wake-mcp: WAKE_CONFIG names "
                    + path
                    + ", which does not exist, so there is no token to bridge with. Put "
                    + "WAKE_MCP_TOKEN=<token> there, or unset WAKE_CONFIG to ask for the legacy "
                    + "two-tool helper on purpose."
                )
            else:
                note(
                    "wake-mcp: "
                    + path
                    + " has no WAKE_MCP_TOKEN, so this session would be the legacy two-tool "
                    + "helper instead of the bridge. Add the token there, or unset WAKE_CONFIG to "
                    + "ask for the helper on purpose."
                )
            sys.exit(2)
        run_legacy()
