#!/usr/bin/env python3
# desc: tiny MCP stdio server exposing wake as tools (wake_bot, wake_list) so an agent can wake a bot mid-task. Not registered anywhere by default.
import json, os, subprocess, sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wake_config  # noqa: E402

TOOLS = [
    {"name": "wake_bot",
     "description": "Wake one of the registered bots (see wake_list) with a short message. Use level error for failures, info for a request, ok for a quiet note. Private bots are refused.",
     "inputSchema": {"type": "object", "required": ["bot", "message"], "properties": {
         "bot": {"type": "string"}, "message": {"type": "string", "maxLength": 500},
         "level": {"type": "string", "enum": ["ok", "error", "info"]}, "ref": {"type": "string"}}}},
    {"name": "wake_list", "description": "List bots that can be woken.", "inputSchema": {"type": "object", "properties": {}}},
]


def call(name, a):
    if name == "wake_list":
        cmd = ["wake", "--list"]
    elif name == "wake_bot":
        cmd = ["wake", str(a["bot"]), str(a["message"])[:500], "--source", "harness:mcp", "--level", a.get("level", "info")]
        if a.get("ref"):
            cmd += ["--ref", str(a["ref"])]
    else:
        return "unknown tool", True
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    return (r.stdout + r.stderr).strip() or "(no output)", r.returncode != 0


def reply(i, result=None, error=None):
    m = {"jsonrpc": "2.0", "id": i}
    m.update({"error": error} if error else {"result": result})
    sys.stdout.write(json.dumps(m) + "\n")
    sys.stdout.flush()


for line in sys.stdin:
    try:
        m = json.loads(line)
    except Exception:
        continue
    i, method = m.get("id"), m.get("method")
    if i is None:
        continue
    if method == "initialize":
        reply(i, {"protocolVersion": "2024-11-05", "capabilities": {"tools": {}}, "serverInfo": {"name": "wake", "version": wake_config.VERSION}})
    elif method == "tools/list":
        reply(i, {"tools": TOOLS})
    elif method == "tools/call":
        p = m.get("params", {})
        try:
            text, err = call(p.get("name"), p.get("arguments") or {})
        except Exception as e:
            text, err = str(e), True
        reply(i, {"content": [{"type": "text", "text": text}], "isError": err})
    else:
        reply(i, error={"code": -32601, "message": "method not found"})
